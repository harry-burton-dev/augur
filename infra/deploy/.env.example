# Copy to infra/deploy/.env and fill in. Never commit the filled-in file.

# Where the platform will live: https://<TS_HOSTNAME>.<your tailnet>.ts.net
# (your tailnet name is in the Tailscale admin console under DNS).
PLATFORM_URL=https://platform.example-tailnet.ts.net
TS_HOSTNAME=platform
# A Tailscale auth key (Settings → Keys → Generate auth key; reusable is easiest).
TS_AUTHKEY=tskey-auth-...

# Long random strings; `openssl rand -hex 32` makes one.
POSTGRES_PASSWORD=
SERVICE_TOKEN=
KEYCLOAK_ADMIN_PASSWORD=

# You: the first person who can sign in (Keycloak needs every one of these).
# You'll be asked to change the password on first sign-in.
PLATFORM_ADMIN_USER=harry
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_FIRST_NAME=Harry
PLATFORM_ADMIN_LAST_NAME=Burton
PLATFORM_ADMIN_DEPARTMENT=Platform
# Optional: what the organisation's own floor is called (default Organisation).
# ORG_NAME=

# Nightly backups land in infra/deploy/backups. Optional: when (hour, UTC) and how many days to keep.
# BACKUP_HOUR_UTC=2
# BACKUP_KEEP_DAYS=14
