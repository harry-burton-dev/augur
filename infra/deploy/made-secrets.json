{
  "$comment": "What the make-secrets job writes into each service's own secrets folder (ADR 0107; AUGUR's docs, Settings and secrets, Secrets AUGUR makes). Each service mounts only its own, as the volume secrets-<service>, at /run/augur/secrets. Each file is the setting it is named after; {NAME} stands for that secret's value: the one AUGUR made, or the one .env sets, which wins. pnpm check:settings holds this file to compose.yml and the schema.",
  "postgres": {
    "POSTGRES_PASSWORD": "{POSTGRES_PASSWORD}"
  },
  "backup": {
    "PGPASSWORD": "{POSTGRES_PASSWORD}"
  },
  "garage": {
    "GARAGE_RPC_SECRET": "{GARAGE_RPC_SECRET}",
    "GARAGE_ADMIN_TOKEN": "{GARAGE_ADMIN_TOKEN}"
  },
  "storage": {
    "DATABASE_URL": "postgres://platform:{POSTGRES_PASSWORD}@postgres:5432/platform",
    "IDENTITY_DATABASE_PASSWORD": "{IDENTITY_DATABASE_PASSWORD}",
    "REGISTRY_DATABASE_PASSWORD": "{REGISTRY_DATABASE_PASSWORD}",
    "EVENTS_DATABASE_PASSWORD": "{EVENTS_DATABASE_PASSWORD}",
    "MODELS_DATABASE_PASSWORD": "{MODELS_DATABASE_PASSWORD}",
    "PERMISSIONS_DATABASE_PASSWORD": "{PERMISSIONS_DATABASE_PASSWORD}",
    "KEYCLOAK_DATABASE_PASSWORD": "{KEYCLOAK_DATABASE_PASSWORD}",
    "GARAGE_ADMIN_TOKEN": "{GARAGE_ADMIN_TOKEN}",
    "FRONTENDS_BUCKET_SECRET": "{FRONTENDS_BUCKET_SECRET}"
  },
  "keycloak": {
    "KC_DB_PASSWORD": "{KEYCLOAK_DATABASE_PASSWORD}",
    "KC_BOOTSTRAP_ADMIN_PASSWORD": "{KEYCLOAK_ADMIN_PASSWORD}",
    "IDENTITY_CLIENT_SECRET": "{IDENTITY_CLIENT_SECRET}"
  },
  "keycloak-config": {
    "KEYCLOAK_ADMIN_PASSWORD": "{KEYCLOAK_ADMIN_PASSWORD}",
    "IDENTITY_CLIENT_SECRET": "{IDENTITY_CLIENT_SECRET}",
    "SERVICE_CLIENT_SECRETS": "platform-registry={REGISTRY_CLIENT_SECRET},platform-events={EVENTS_CLIENT_SECRET},platform-models={MODELS_CLIENT_SECRET},platform-knowledge={KNOWLEDGE_CLIENT_SECRET},platform-permissions={PERMISSIONS_CLIENT_SECRET},platform-updater={UPDATER_CLIENT_SECRET},platform-fleet={FLEET_CLIENT_SECRET}",
    "DATABASE_URL": "postgres://platform_identity:{IDENTITY_DATABASE_PASSWORD}@postgres:5432/platform"
  },
  "identity": {
    "SERVICE_CLIENT_SECRET": "{IDENTITY_CLIENT_SECRET}",
    "DATABASE_URL": "postgres://platform_identity:{IDENTITY_DATABASE_PASSWORD}@postgres:5432/platform"
  },
  "gateway": {
    "CALLER_SIGNING_KEY": "{CALLER_SIGNING_KEY}"
  },
  "registry": {
    "SERVICE_CLIENT_SECRET": "{REGISTRY_CLIENT_SECRET}",
    "DATABASE_URL": "postgres://platform_registry:{REGISTRY_DATABASE_PASSWORD}@postgres:5432/platform",
    "ALERT_WEBHOOK_TOKEN": "{ALERT_WEBHOOK_TOKEN}",
    "FRONTENDS_BUCKET_SECRET": "{FRONTENDS_BUCKET_SECRET}"
  },
  "events": {
    "SERVICE_CLIENT_SECRET": "{EVENTS_CLIENT_SECRET}",
    "DATABASE_URL": "postgres://platform_events:{EVENTS_DATABASE_PASSWORD}@postgres:5432/platform"
  },
  "models": {
    "SERVICE_CLIENT_SECRET": "{MODELS_CLIENT_SECRET}",
    "DATABASE_URL": "postgres://platform_models:{MODELS_DATABASE_PASSWORD}@postgres:5432/platform"
  },
  "knowledge-migrate": {
    "DATABASE_URL": "postgres://platform:{POSTGRES_PASSWORD}@postgres:5432/platform",
    "KNOWLEDGE_DATABASE_PASSWORD": "{KNOWLEDGE_DATABASE_PASSWORD}"
  },
  "knowledge": {
    "SERVICE_CLIENT_SECRET": "{KNOWLEDGE_CLIENT_SECRET}",
    "DATABASE_URL": "postgres://kg_app:{KNOWLEDGE_DATABASE_PASSWORD}@postgres:5432/platform"
  },
  "openfga": {
    "OPENFGA_DATASTORE_URI": "postgres://platform_permissions:{PERMISSIONS_DATABASE_PASSWORD}@postgres:5432/platform",
    "OPENFGA_AUTHN_PRESHARED_KEYS": "{OPENFGA_TOKEN}"
  },
  "permissions": {
    "SERVICE_CLIENT_SECRET": "{PERMISSIONS_CLIENT_SECRET}",
    "DATABASE_URL": "postgres://platform_permissions:{PERMISSIONS_DATABASE_PASSWORD}@postgres:5432/platform",
    "OPENFGA_TOKEN": "{OPENFGA_TOKEN}"
  },
  "updater": {
    "SERVICE_CLIENT_SECRET": "{UPDATER_CLIENT_SECRET}"
  },
  "otel-lgtm": {
    "GF_SECURITY_ADMIN_PASSWORD": "{GRAFANA_ADMIN_PASSWORD}",
    "ALERT_WEBHOOK_TOKEN": "{ALERT_WEBHOOK_TOKEN}"
  }
