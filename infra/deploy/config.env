# AUGUR's defaults for settings its own services read (ADR 0107). It ships with AUGUR, so don't edit it on a
# server: each service reads it first and the deployment's .env over it (on a platform host such as Coolify, the
# host's variables), so set a different value there. settings.schema.json describes every setting, and
# .env.example lists the ones a deployment sets.

# Where the shell and every app load the UI kit from.
KIT_URL=/kit/

# What people see the product called: the browser tab, the sign-in pages and emails (the realm's display name).
ORG_PRODUCT_NAME=AUGUR

# true lets a deployment admin fill this deployment with synthetic sample data (pnpm seed). Never where real people work.
SEED_ALLOWED=false

# What the organisation is called at first start. After that an admin changes it in Admin, Organisation (ADR 0042); the sign-in pages still read it.
ORG_NAME=Organisation

# The most one page of a knowledge graph read gives, whatever the caller asks for.
KNOWLEDGE_PAGE_LIMIT=100

# The most hops a knowledge graph subgraph read goes from its entity, whatever the caller asks for.
KNOWLEDGE_SUBGRAPH_DEPTH=3

# How long an entity's beliefs must be quiet before the knowledge graph writes its summaries, in seconds.
KNOWLEDGE_REFLECT_DEBOUNCE_SECONDS=600

# The most knowledge graph summaries written a day (UTC) for the whole deployment. Keep it under the models service's daily limit, with room for extraction.
KNOWLEDGE_REFLECT_DAILY_BUDGET=400

# The most knowledge graph summaries written a day (UTC) on any one floor.
KNOWLEDGE_REFLECT_FLOOR_BUDGET=100

# The longest someone may act as a deployment admin persona at a time, in minutes. They sign in again and give a reason each time (ADR 0086).
PERSONA_DEPLOYMENT_ADMIN_MINUTES=60

# The longest someone may act as an org admin persona at a time, in minutes. They sign in again and give a reason each time (ADR 0086).
PERSONA_ORG_ADMIN_MINUTES=480

# How often the permissions service copies floors, positions and who holds them whole from identity, in seconds, to put right anything an event missed. Each change identity announces is copied as it happens.
PERMISSIONS_COPY_SECONDS=300
