{
  "realm": "platform",
  "displayName": "AUGUR",
  "enabled": true,
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Runs the platform; sees the Admin app"
      },
      {
        "name": "editor",
        "description": "Can publish to libraries"
      },
      {
        "name": "publisher",
        "description": "Publishes to the whole org and to any team"
      },
      {
        "name": "deployment-admin",
        "description": "Runs the deployment: settings, secrets, updates and backups"
      }
    ]
  },
  "groups": [
    {
      "name": "${PLATFORM_ADMIN_DEPARTMENT}"
    }
  ],
  "users": [
    {
      "username": "${PLATFORM_ADMIN_USER}",
      "enabled": true,
      "email": "${PLATFORM_ADMIN_EMAIL}",
      "emailVerified": true,
      "firstName": "${PLATFORM_ADMIN_FIRST_NAME}",
      "lastName": "${PLATFORM_ADMIN_LAST_NAME}",
      "credentials": [
        {
          "type": "password",
          "value": "${PLATFORM_ADMIN_PASSWORD}",
          "temporary": true
        }
      ],
      "realmRoles": [
        "default-roles-platform",
        "admin",
        "editor",
        "deployment-admin"
      ],
      "groups": [
        "/${PLATFORM_ADMIN_DEPARTMENT}"
      ],
      "requiredActions": [
        "UPDATE_PASSWORD"
      ]
    },
    {
      "username": "service-account-platform-identity",
      "enabled": true,
      "serviceAccountClientId": "platform-identity",
      "clientRoles": {
        "realm-management": [
          "view-realm",
          "view-users",
          "query-users",
          "manage-users",
          "query-groups",
          "view-clients",
          "query-clients",
          "manage-clients"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "shell",
      "name": "Platform shell",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "${PLATFORM_URL}/*"
      ],
      "webOrigins": [
        "${PLATFORM_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PLATFORM_URL}/*"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "web-origins",
        "acr"
      ],
      "protocolMappers": [
        {
          "name": "platform-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "platform-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "departments",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "departments",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "platform-cli",
      "name": "AUGUR command line",
      "description": "Signs a person in from a terminal with a one-time code (device grant), for pnpm seed. ADR 0056.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "oauth2.device.code.lifespan": "300",
        "oauth2.device.polling.interval": "5"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "web-origins",
        "acr"
      ],
      "protocolMappers": [
        {
          "name": "platform-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "platform-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "departments",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "departments",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "platform-identity",
      "name": "Identity service",
      "enabled": true,
      "publicClient": false,
      "secret": "${IDENTITY_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false
    }
  ]
}
