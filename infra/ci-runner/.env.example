# Copy to infra/ci-runner/.env (chmod 600). docs/ci-runner.md says where each value comes from.
REPO_URL=https://github.com/harry-burton-dev/im-platform
# The one-hour token from GitHub's "New self-hosted runner" page, used once to register.
# Empty it after the runner shows as Idle; it's useless by then anyway.
RUNNER_TOKEN=
# Only with COMPOSE_PROFILES=two: a second token from the same page.
RUNNER_2_TOKEN=
# Each runner's share of the server, so CI never starves AUGUR.
CI_CPUS=4
CI_MEMORY=8g
