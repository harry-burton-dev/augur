{
  "realm": "platform",
  "displayName": "AUGUR",
  "enabled": true,
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Runs AUGUR; sees the Admin app" },
      { "name": "editor", "description": "Can publish to libraries" },
      { "name": "publisher", "description": "Publishes to the whole org and to any team" },
      { "name": "deployment-admin", "description": "Runs the deployment: settings, secrets, updates and backups" }
    ]
  },
  "groups": [{ "name": "Finance" }, { "name": "Legal" }],
  "users": [
    {
      "username": "alex",
      "enabled": true,
      "email": "alex@example.org",
      "emailVerified": true,
      "firstName": "Alex",
      "lastName": "Rivera",
      "credentials": [{ "type": "password", "value": "platform-local-only", "temporary": false }],
      "realmRoles": ["default-roles-platform", "admin", "editor"],
      "groups": ["/Finance"]
    },
    {
      "username": "sam",
      "enabled": true,
      "email": "sam@example.org",
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Okafor",
      "credentials": [{ "type": "password", "value": "platform-local-only", "temporary": false }],
      "realmRoles": ["default-roles-platform", "editor"],
      "groups": ["/Legal"]
    }
  ],
  "clients": [
    {
      "clientId": "shell",
      "name": "Platform shell",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "defaultClientScopes": ["basic", "profile", "email", "web-origins", "acr"],
      "protocolMappers": [
        {
          "name": "platform-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "platform-api", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": { "claim.name": "roles", "multivalued": "true", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" }
        },
        {
          "name": "departments",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": { "claim.name": "departments", "full.path": "false", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "platform-cli",
      "name": "AUGUR command line",
      "description": "Signs a person in from a terminal with a one-time code (device grant), for pnpm seed. ADR 0056.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "oauth2.device.code.lifespan": "300",
        "oauth2.device.polling.interval": "5"
      },
      "defaultClientScopes": ["basic", "profile", "email", "web-origins", "acr"],
      "protocolMappers": [
        {
          "name": "platform-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "platform-api", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": { "claim.name": "roles", "multivalued": "true", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" }
        },
        {
          "name": "departments",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": { "claim.name": "departments", "full.path": "false", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" }
        }
      ]
    }
  ]
}
