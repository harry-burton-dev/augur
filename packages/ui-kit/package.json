{
  "name": "@im/ui-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design tokens, base CSS and web components rebuilt from the Claude Design system (working name Wave).",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css"
  },
  "files": ["dist"],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "node scripts/build-tokens.mjs && tsc -p tsconfig.json && cp src/base.css dist/base.css",
    "typecheck": "node scripts/build-tokens.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build-tokens.mjs && vitest run"
  },
  "dependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "happy-dom": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
