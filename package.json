{
  "name": "augur",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --parallel",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "register-app": "node scripts/register-app.mjs",
    "check:versions": "node scripts/versions.mjs check",
    "check:release": "node scripts/augur-release.mjs check",
    "check:migrations": "node scripts/check-migrations.mjs check",
    "sync:migrations": "node scripts/check-migrations.mjs sync",
    "test:scripts": "node --test scripts/*.test.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/versions.mjs sync && node scripts/augur-release.mjs version && node scripts/catalog.mjs",
    "check:manifest": "node scripts/check-manifests.mjs",
    "create-app": "node scripts/create-app.mjs",
    "dev:app": "node scripts/dev-app.mjs",
    "check:reasons": "node scripts/check-reasons.mjs",
    "catalog": "node scripts/catalog.mjs",
    "check:catalog": "node scripts/catalog.mjs check",
    "lint": "eslint . --max-warnings 2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "semver": "^7.8.5",
    "turbo": "^2.5.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "yaml": "^2.9.1"
  }
}
