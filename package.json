{
  "name": "augur",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --parallel",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "register-app": "node scripts/register-app.mjs",
    "check:versions": "node scripts/versions.mjs check",
    "check:release": "node scripts/augur-release.mjs check",
    "check:settings": "node scripts/check-settings.mjs",
    "check:upgrade-notes": "node scripts/upgrade-notes.mjs check",
    "check:migrations": "node scripts/check-migrations.mjs check",
    "sync:migrations": "node scripts/check-migrations.mjs sync",
    "test:scripts": "node --test scripts/*.test.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/versions.mjs sync && node scripts/augur-release.mjs version && node scripts/catalog.mjs && node scripts/licences.mjs notices",
    "check:manifest": "node scripts/check-manifests.mjs",
    "manifest-schema": "node scripts/manifest.schema.mjs",
    "dev:app": "node scripts/dev-app.mjs",
    "check:reasons": "node scripts/check-reasons.mjs",
    "catalog": "node scripts/catalog.mjs",
    "check:catalog": "node scripts/catalog.mjs check",
    "seed": "node scripts/seed.mjs",
    "check:licences": "node scripts/licences.mjs check",
    "check:repo-security": "node scripts/check-repo-security.mjs",
    "notices": "node scripts/licences.mjs notices",
    "lint": "eslint .",
    "check:kit": "node scripts/kit.mjs check",
    "kit:pin": "node scripts/kit.mjs pin",
    "contracts": "node scripts/check-contracts.mjs write",
    "check:contracts": "node scripts/check-contracts.mjs check",
    "check:api": "node scripts/check-api.mjs",
    "api:update": "node scripts/check-api.mjs update",
    "knip": "knip",
    "coverage:summary": "node scripts/coverage-summary.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@vitest/coverage-v8": "3.2.7",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "publint": "^0.3.25",
    "semver": "^7.8.5",
    "squawk-cli": "2.70.0",
    "turbo": "^2.5.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "yaml": "^2.9.1"
  }
}
