{
  "name": "augur",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --parallel",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "register-app": "node scripts/register-app.mjs",
    "check:versions": "node scripts/versions.mjs check",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/versions.mjs sync",
    "release": "changeset tag",
    "check:manifest": "node scripts/check-manifests.mjs",
    "create-app": "node scripts/create-app.mjs",
    "dev:app": "node scripts/dev-app.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "semver": "^7.8.5",
    "turbo": "^2.5.0",
    "typescript": "^5.6.0"
  }
}
