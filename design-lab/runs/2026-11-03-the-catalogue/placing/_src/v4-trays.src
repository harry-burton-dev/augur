/*@meta {"n":4,"title":"Sorting frame","cap":"a sorting frame of labelled trays; hold the thing over a tray and its label checks what that tray expects · Royal Mail sorting frames, museum accession trays, the returns slot"}*/
/*@css*/
.grid{position:absolute;inset:0;display:grid;grid-template-columns:minmax(0,1fr) var(--x-col-side);gap:var(--space-5)}
.left{display:flex;flex-direction:column;gap:var(--space-3);min-height:0}
.said p{display:none}
@media (max-height:840px){.said .from{display:none}}
.frame{position:relative;flex:1;min-height:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:repeat(3,minmax(0,1fr));gap:var(--space-2);padding:var(--space-2);border-radius:var(--radius-inset);background:color-mix(in srgb,var(--slate-deep) 80%,transparent);box-shadow:inset 0 0 0 1px var(--hairline)}
.tray{position:relative;display:flex;flex-direction:column;gap:var(--space-1);padding:var(--space-2) var(--space-3);border-radius:var(--radius-key);background:linear-gradient(var(--surface-inset),color-mix(in srgb,var(--slate-deep) 60%,transparent));box-shadow:inset 0 calc(var(--space-1) * -1) 0 color-mix(in srgb,var(--shade) 30%,transparent);min-height:0;overflow:hidden;transition:background var(--motion-base) var(--ease-standard),box-shadow var(--motion-base) var(--ease-standard),opacity var(--motion-base) var(--ease-standard)}
.tray .plate{display:flex;align-items:center;justify-content:space-between;gap:var(--space-2);padding-bottom:var(--space-1);border-bottom:1px solid var(--hairline)}
.tray .plate .kind{font-size:var(--type-meta);color:var(--light)}
.tray .says{font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink-muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.slot{display:block;flex:none;height:var(--target-sm)}
.chips{display:flex;flex-wrap:wrap;gap:var(--space-1);margin-top:auto}
.chip{display:inline-flex;align-items:center;gap:calc(var(--space-1) / 2);font-size:var(--type-small);line-height:1;padding:var(--space-1) var(--space-2);border-radius:var(--radius-pill);border:1px solid var(--hairline);color:var(--ink-muted);white-space:nowrap}
.chip svg{width:var(--space-3);height:var(--space-3)}
.chip.has{border-color:color-mix(in srgb,var(--success) 50%,transparent);color:var(--ink)}
.chip.has svg{color:var(--success)}
.chip.could{border-style:dashed;border-color:var(--x-gap-edge);color:var(--ink)}
.chip.cant{color:var(--ink-muted);text-decoration:line-through}
.chip.cant svg{color:var(--danger)}
.tray .fit{font:400 var(--x-type-micro)/1 var(--font-mono);letter-spacing:var(--tracking-caps);text-transform:uppercase;color:var(--ink-muted)}
.tray.over{background:linear-gradient(var(--surface-raised),var(--surface-inset));box-shadow:inset 0 0 0 1px var(--x-accent-edge)}
.tray.over.good .fit{color:var(--x-accent)}
.tray.over.poor .fit{color:var(--ink)}
.tray.in{box-shadow:inset 0 0 0 1px var(--x-accent);background:var(--x-accent-soft)}
.tray.ext .plate .kind svg{color:var(--ink-muted)}
.tray.nofit .says{-webkit-line-clamp:4 !important}
.tray.nofit{background:transparent;box-shadow:none;border:1px dashed var(--x-gap-edge)}
.tray.nofit .plate .kind svg{color:var(--x-wait)}
.tray.nofit.over{border-color:var(--x-wait);box-shadow:none;background:color-mix(in srgb,var(--x-wait) 8%,transparent)}
.frame.done .tray:not(.in){opacity:.5}
.tray.tried:not(.over){opacity:.7}
/* the thing itself, as a parcel label that travels over the frame */
.tag{position:absolute;z-index:2;display:inline-flex;align-items:center;gap:var(--space-2);padding:var(--space-1) var(--space-3);border-radius:var(--radius-key);background:var(--ink);color:var(--slate-deep);font-size:var(--type-small);white-space:nowrap;box-shadow:var(--shadow-raised);transform:translate(-50%,-50%) rotate(-2deg);transition:left var(--motion-slow) var(--ease-out),top var(--motion-slow) var(--ease-out),transform var(--motion-base) var(--ease-out);pointer-events:none}
.tag svg{width:var(--space-3);height:var(--space-3)}
.tag.drop{transform:translate(-50%,-50%) rotate(0) scale(.92)}
.right{display:flex;flex-direction:column;gap:var(--space-3);min-height:0;overflow:auto;scrollbar-width:thin}
.right .idle{color:var(--ink-muted);font-size:var(--type-small);line-height:var(--leading-small);border:1px dashed var(--hairline-strong);border-radius:var(--radius-inset);padding:var(--space-3) var(--space-4)}
@media (max-height:840px){.tray .says{-webkit-line-clamp:1}.chip{padding:calc(var(--space-1) / 2) var(--space-2);font-size:var(--x-type-micro)}.tray{padding:var(--space-1) var(--space-2)}}
/*@html*/
<div class="grid">
  <div class="left">
    <div id="thing"></div>
    <div class="frame" id="frame" role="grid" aria-label="Sorting frame"></div>
  </div>
  <aside class="right" id="right" aria-live="polite"></aside>
</div>
/*@js*/
const TRAYS = [...DATA.kinds.map(k => ({ ...k })), ...DATA.elsewhere.filter(e => e.id === 'document').map(e => ({ ...e, ext: true })), { id: 'nofit', nofit: true }];
const V = {
  title: 'Add a thing', sub: 'Hold it over a tray. Each tray’s label says what goes in and checks the details it expects. If no tray fits, the last one sends it to an admin. <b>Every tray empties into Triage.</b>',
  keys() { return [['← → ↑ ↓', 'hold over a tray'], ['Space', 'drop it in'], ['Y', 'that’s it'], ['Enter', 'it’s new']]; },
  reset() { this.tried = new Set(); this.at = -1; this.inTray = null; this.result = undefined; $('#thing').innerHTML = thingCard(); this.draw(); $('#right').innerHTML = `<div class="idle">Things already in a tray that look like yours show here when you drop it in, so nothing is kept twice.</div>`; },
  fit(k) {
    const t = DATA.things[MODE], tw = t.tryOn && t.tryOn[k.id];
    return k.has.map(h => { const v = tw && h in tw ? tw[h] : t.known && t.known[h] ? t.known[h] : k.id === t.kind ? null : undefined; return { h, v }; });
  },
  draw() {
    const f = $('#frame'); f.classList.toggle('done', !!this.inTray);
    f.innerHTML = TRAYS.map((k, i) => {
      if (k.nofit) return `<div class="tray nofit${this.at === i ? ' over' : ''}${this.inTray === 'nofit' ? ' in' : ''}" role="gridcell" data-i="${i}"><div class="plate"><span class="kind">${ic('hourglass')}<span>No tray fits</span></span></div>
        ${this.at === i ? '<span class="slot"></span>' : ''}<span class="says">Leave it here. ${DATA.admin.name} is asked for a new kind; it waits in Triage, nothing lost.${st(W('ask')[1])}</span></div>`;
      if (k.ext) return `<div class="tray ext" role="gridcell" data-i="${i}"><div class="plate"><span class="kind">${ic(k.icon)}<span>Written down</span></span><span class="micro">${k.app}</span></div>
        <span class="says">Reports, letters and forms go to ${k.app}. Data Atlas keeps what they’re about.</span></div>`;
      const over = this.at === i, tried = this.tried.has(k.id), fit = over || tried || this.inTray === k.id ? this.fit(k) : null;
      let cls = '', label = '';
      if (fit) { const cant = fit.filter(x => x.v === false).length, ok = fit.filter(x => x.v).length;
        cls = cant ? ' poor' : ' good'; label = cant ? `${cant} of ${fit.length} can’t apply` : `fits · ${ok} known · ${fit.length - ok} to find`; }
      const chips = (fit || k.has.map(h => ({ h, v: undefined }))).map(({ h, v }) =>
        v === false ? `<span class="chip cant">${ic('x')}${h}</span>` : v ? `<span class="chip has" title="${v}">${ic('check')}${h}</span>` : v === null ? `<span class="chip could">${h}</span>` : `<span class="chip">${h}</span>`).join('');
      return `<div class="tray${over ? ' over' : ''}${tried && !over ? ' tried' : ''}${cls}${this.inTray === k.id ? ' in' : ''}" role="gridcell" data-i="${i}"><div class="plate">${kindChip(k)}</div>
        ${fit ? `<span class="fit">${tried && !over ? 'tried · ' : ''}${label}</span>` : `<span class="says">${k.says}</span>`}${over || this.inTray === k.id ? '<span class="slot"></span>' : ''}<div class="chips">${chips}</div></div>`;
    }).join('') + `<div class="tag" id="tag">${ic('tag')}${DATA.things[MODE].said}</div>`;
    Icons.hydrate(f); this.place();
  },
  place() {
    const tag = $('#tag'), f = $('#frame');
    if (this.at < 0) { tag.style.left = 'calc(100% - var(--space-2))'; tag.style.top = 'calc(var(--space-4) * -1)'; return; }
    const tr = $(`[data-i="${this.at}"]`, f), sl = $('.slot', tr) || tr, fr = f.getBoundingClientRect(), r = sl.getBoundingClientRect();
    tag.style.left = `${r.left - fr.left + r.width / 2}px`; tag.style.top = `${r.top - fr.top + r.height / 2}px`;
    tag.classList.toggle('drop', !!this.inTray);
  },
  move(i) { if (this.inTray) return; if (TRAYS[i] && TRAYS[i].ext) { /* written things go to Artifacts: skip over */ } if (this.at >= 0 && !TRAYS[this.at].nofit && !TRAYS[this.at].ext) this.tried.add(TRAYS[this.at].id); this.at = i; steps(1); this.draw(); },
  drop() {
    if (this.at < 0 || this.inTray) return; const k = TRAYS[this.at];
    if (k.ext) return;
    if (k.nofit) { this.inTray = 'nofit'; this.result = null; this.draw(); $('#right').innerHTML = slipHTML(); steps(3, true); }
    else { const fit = this.fit(k); if (fit.some(x => x.v === false)) { $('#right').innerHTML = `<div class="idle">${k.word} expects ${fit.filter(x => x.v === false).map(x => x.h).join(', ')}, and yours can’t have ${fit.filter(x => x.v === false).length > 1 ? 'them' : 'it'}. Try another tray, or leave it in “No tray fits”.</div>`; return; }
      this.inTray = k.id; this.result = k.id; this.draw();
      $('#right').innerHTML = nearHTML(DATA.near.fits.filter(n => n.kind === k.id).concat(DATA.near.fits.filter(n => n.kind !== k.id)), { head: `Already in the ${k.word} tray: is it one of these?` }); steps(2); }
    Icons.hydrate($('#right')); reveal($('#right').firstElementChild);
  },
  done(same) { if (MODE !== 'fits' || !this.result) return; $('#right').innerHTML = slipHTML(this.result, same); steps(3); reveal($('#right').firstElementChild); },
  demo() {
    steps(1); const route = DATA.things[MODE].route, gap = ms('--motion-calm');
    route.forEach((id, j) => later(() => this.move(TRAYS.findIndex(k => k.id === id)), gap * j * 1.5));
    later(() => this.drop(), gap * (route.length - 1) * 1.5 + gap);
  },
  key(e) {
    const cols = 3, n = TRAYS.length, a = this.at < 0 ? 0 : this.at;
    const m = { ArrowRight: a + 1, ArrowLeft: a - 1, ArrowDown: a + cols, ArrowUp: a - cols }[e.key];
    if (m != null) { if (this.at < 0) this.move(0); else if (m >= 0 && m < n) this.move(m); return true; }
    if (e.key === ' ') { this.drop(); return true; }
    if (e.key.toLowerCase() === 'y') { this.done('wu7'); return true; }
    if (e.key === 'Enter' && this.result) { this.done(null); return true; }
  }
};
document.addEventListener('click', e => { const t = e.target.closest('.tray'); if (!t) return; const i = +t.dataset.i; if (V.at === i) V.drop(); else V.move(i); });
addEventListener('resize', () => V.place());
boot(V);
