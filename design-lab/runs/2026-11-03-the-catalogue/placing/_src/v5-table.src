/*@meta {"n":5,"title":"Slot finder","cap":"a periodic table of kinds: two questions find the slot, and empty slots are kinds the table predicts · Mendeleev 1869 (eka-aluminium), group VIII's shared cell"}*/
/*@css*/
:root{--x-cell:calc(var(--space-8) - var(--space-3))}  /* 104: one element tile */
.grid{position:absolute;inset:0;display:grid;grid-template-columns:minmax(0,1fr) var(--x-col-side);gap:var(--space-5)}
.left{display:flex;flex-direction:column;gap:var(--space-3);min-height:0}
.said p{display:none}
.qs{display:flex;gap:var(--space-4);font-size:var(--type-small);color:var(--ink-muted)}
.qs .q{display:flex;align-items:center;gap:var(--space-2)}
.qs .q b{font-weight:400;color:var(--ink)}
.qs .q.on b{color:var(--x-accent)}
.pt{display:grid;grid-template-columns:calc(var(--space-8) + var(--space-3)) repeat(5,minmax(0,1fr));gap:var(--space-1)}
.pt .gh,.pt .rh{display:flex;flex-direction:column;justify-content:flex-end;padding:var(--space-1) var(--space-2);border-radius:var(--radius-key);font-size:var(--type-meta);line-height:var(--leading-meta);color:var(--ink);transition:background var(--motion-base) var(--ease-standard),color var(--motion-base) var(--ease-standard)}
.pt .gh{align-items:flex-start;border-bottom:1px solid var(--hairline-strong)}
.pt .gh .micro,.pt .rh .micro{font-size:var(--x-type-micro)}
.pt .rh{justify-content:center;border-right:1px solid var(--hairline-strong);font-size:var(--type-small);line-height:var(--leading-small)}
.pt .gh.on,.pt .rh.on{background:var(--x-accent-soft);color:var(--light)}
.pt .gh.on .micro,.pt .rh.on .micro{color:var(--x-accent)}
.cell{position:relative;min-height:var(--x-cell);border-radius:var(--radius-key);display:flex;flex-direction:column;gap:var(--space-1);padding:var(--space-1);transition:opacity var(--motion-slow) var(--ease-standard),box-shadow var(--motion-base) var(--ease-standard),background var(--motion-base) var(--ease-standard)}
.cell.none{background:repeating-linear-gradient(135deg,transparent 0 var(--space-2),color-mix(in srgb,var(--hairline) 60%,transparent) var(--space-2) calc(var(--space-2) + 1px));opacity:.6}
.el{position:relative;flex:1;display:flex;flex-direction:column;justify-content:space-between;padding:var(--space-1) var(--space-2);border-radius:var(--radius-key);background:var(--surface-raised);border:1px solid var(--hairline-strong);min-height:0}
.el .z{display:flex;justify-content:space-between;align-items:baseline;font:400 var(--x-type-micro)/1 var(--font-mono);color:var(--ink-muted)}
.el .z svg{width:var(--space-3);height:var(--space-3);color:var(--x-accent)}
.el .sym{font:200 var(--type-title-s)/1 var(--font-sans);color:var(--light);letter-spacing:var(--tracking-tight)}
.el .en{font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink)}
.cell.two .el .sym{font-size:var(--type-heading)}
.el.pred{background:transparent;border:1px dashed var(--x-gap-edge)}
.el.pred .sym{color:var(--ink-muted)}
.el.pred .en{color:var(--ink-muted);font-style:italic}
.el.pred .asks{font:400 var(--x-type-micro)/1 var(--font-mono);color:var(--x-wait)}
.pt.aim .cell{opacity:.38}
.pt.aim .cell.inrow,.pt.aim .cell.incol{opacity:.7}
.pt.aim .cell.hit{opacity:1;box-shadow:0 0 0 1px var(--x-accent),0 0 var(--glow-blur) color-mix(in srgb,var(--x-accent) 35%,transparent);background:var(--x-accent-soft)}
.cell.hit .el.pick{border-color:var(--x-accent)}
.cell.hit .el.not{opacity:var(--x-out)}
.cell.hit .el.pred{border-color:var(--x-wait)}
.split{margin-top:var(--space-2);display:flex;gap:var(--space-2);align-items:center;font-size:var(--type-small);color:var(--ink-muted)}
.split b{font-weight:400;color:var(--ink)}
.outside{display:flex;gap:var(--space-2);margin-top:var(--space-1)}
.outside .o{flex:1;display:flex;gap:var(--space-2);align-items:center;padding:var(--space-2) var(--space-3);border:1px solid var(--hairline);border-radius:var(--radius-key);font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink-muted)}
.outside .o svg{width:var(--space-4);height:var(--space-4);flex:none}
.outside .o b{font-weight:400;color:var(--ink)}
.legend{display:flex;gap:var(--space-4);font-size:var(--type-small);color:var(--ink-muted);align-items:center}
.legend span{display:inline-flex;gap:var(--space-2);align-items:center}
.legend i{display:inline-block;width:var(--space-4);height:var(--space-3);border-radius:2px}
.legend i.k{background:var(--surface-raised);border:1px solid var(--hairline-strong)}
.legend i.p{border:1px dashed var(--x-gap-edge)}
.legend i.n{background:repeating-linear-gradient(135deg,transparent 0 3px,var(--hairline-strong) 3px 4px)}
.right{display:flex;flex-direction:column;gap:var(--space-3);min-height:0;overflow:auto;scrollbar-width:thin}
.right .idle{color:var(--ink-muted);font-size:var(--type-small);line-height:var(--leading-small);border:1px dashed var(--hairline-strong);border-radius:var(--radius-inset);padding:var(--space-3) var(--space-4)}
@media (max-height:840px){:root{--x-cell:calc(var(--space-7) + var(--space-3))}.el .sym{font-size:var(--type-heading)}.cell.two .el .sym{font-size:var(--type-lead)}.said .from{display:none}.outside .o{padding:var(--space-1) var(--space-2)}}
/*@html*/
<div class="grid">
  <div class="left">
    <div id="thing"></div>
    <div class="qs" id="qs"></div>
    <div class="pt" id="pt" role="grid" aria-label="Table of kinds"></div>
    <div class="legend"><span><i class="k"></i>a kind we keep</span><span><i class="p"></i>a kind the table predicts, not made yet</span><span><i class="n"></i>nothing could go here</span></div>
    <div class="outside" id="outside"></div>
  </div>
  <aside class="right" id="right" aria-live="polite"></aside>
</div>
/*@js*/
const NONE = { someone: ['line'], agreement: ['line', 'many'], happening: ['many'] }; /* cells that can't exist: stated, not hidden */
const sym = w => w.slice(0, 2);
const V = {
  title: 'Add a thing', sub: 'Two questions find its slot in the table of kinds: what it is, and its shape. Empty slots are kinds the table predicts. Landing on one is how you ask for it. <b>Then it goes to Triage.</b>',
  keys() { return [['1–5', 'what it is'], ['Q W E', 'its shape'], ['A B', 'pick in a shared slot'], ['Y', 'that’s it'], ['Enter', 'it’s new']]; },
  reset() { this.g = null; this.s = null; this.pick = null; this.result = undefined; $('#thing').innerHTML = thingCard(); this.draw(); $('#right').innerHTML = `<div class="idle">When the slot is found, things we already keep in it that look like yours show here, so nothing is kept twice.</div>`;
    $('#outside').innerHTML = DATA.elsewhere.map(e => `<div class="o">${ic(e.icon)}<span><b>${e.word}</b> isn’t in this table: ${e.app} keeps it.</span></div>`).join(''); },
  cellOf(g, s) { return { kinds: DATA.kinds.filter(k => k.genus === g && k.shape === s), pred: DATA.predicted.find(p => p.genus === g && p.shape === s), none: (NONE[g] || []).includes(s) }; },
  draw() {
    const pt = $('#pt'); pt.classList.toggle('aim', !!(this.g || this.s));
    let h = `<div></div>` + DATA.genera.map((g, i) => `<div class="gh${this.g === g.id ? ' on' : ''}"><span class="micro">${i + 1}</span>${g.word}${st(g.studio)}</div>`).join('');
    DATA.shapes.forEach((s, r) => {
      h += `<div class="rh${this.s === s.id ? ' on' : ''}"><span class="micro">${'QWE'[r]}</span>${s.word}${st(s.studio)}</div>`;
      DATA.genera.forEach(g => {
        const c = this.cellOf(g.id, s.id), hit = this.g === g.id && this.s === s.id;
        const cls = `${c.none ? ' none' : ''}${c.kinds.length > 1 ? ' two' : ''}${hit ? ' hit' : ''}${this.s === s.id ? ' inrow' : ''}${this.g === g.id ? ' incol' : ''}`;
        let inner = '';
        if (c.kinds.length) inner = c.kinds.map(k => `<div class="el${hit && this.pick ? (this.pick === k.id ? ' pick' : ' not') : ''}"><span class="z"><span>${fmt(k.n)}</span>${ic(k.icon, 12)}</span><span class="sym">${sym(k.word)}</span><span class="en">${k.word}${st(k.studio)}</span></div>`).join('');
        else if (c.pred) inner = `<div class="el pred"><span class="z"><span>0</span>${c.pred.asks.length ? `<span class="asks">${c.pred.asks.length} ask</span>` : ''}</span><span class="sym">?</span><span class="en">${c.pred.word}</span></div>`;
        h += `<div class="cell${cls}" role="gridcell" data-g="${g.id}" data-s="${s.id}" aria-label="${g.word}, ${s.word}">${inner}</div>`;
      });
    });
    pt.innerHTML = h; Icons.hydrate(pt);
    const t = DATA.things[MODE];
    $('#qs').innerHTML = `<span class="q${this.g ? ' on' : ''}">What is it? <b>${this.g ? G(this.g).word : '…'}</b></span><span class="q${this.s ? ' on' : ''}">Its shape? <b>${this.s ? DATA.shapes.find(x => x.id === this.s).word : '…'}</b></span>`;
  },
  setG(g) { if (this.result !== undefined) return; this.g = g; steps(1); this.draw(); this.check(); },
  setS(s) { if (this.result !== undefined) return; this.s = s; steps(1); this.draw(); this.check(); },
  check() {
    if (!this.g || !this.s) return;
    const c = this.cellOf(this.g, this.s), r = $('#right');
    if (c.kinds.length === 1) this.land(c.kinds[0].id);
    else if (c.kinds.length > 1) {
      r.innerHTML = `<div class="idle">Two kinds share this slot, like group VIII in Mendeleev’s table. One more question: <b>${c.kinds.map((k, i) => `${'AB'[i]}: it ${k.diff}`).join('; or ')}</b>?</div>`;
      this.shared = c.kinds;
    } else if (c.pred) {
      this.result = null; steps(3, true); r.innerHTML = `<div class="idle" style="border-color:var(--x-wait)">The table predicts a kind here, <b>${c.pred.word}</b>: something that ${c.pred.diff}. Nobody has made it yet. Landing here is your ask.</div>` + slipHTML();
    } else { r.innerHTML = `<div class="idle">Nothing could go in this slot (${G(this.g).word.toLowerCase()}, ${DATA.shapes.find(x => x.id === this.s).word.toLowerCase()}). Check the two answers.</div>`; }
    Icons.hydrate(r); reveal(r.lastElementChild);
  },
  land(id) {
    this.pick = id; this.result = id; this.draw();
    const r = $('#right'); r.innerHTML = nearHTML(); steps(2); Icons.hydrate(r); reveal(r.firstElementChild);
  },
  done(same) { if (MODE !== 'fits' || !this.result) return; $('#right').innerHTML = slipHTML(this.result, same); steps(3); reveal($('#right').firstElementChild); },
  demo() {
    const t = DATA.things[MODE], gap = ms('--motion-calm');
    steps(1); this.setG(t.genus);
    later(() => this.setS(t.shape), gap);
    if (t.kind) later(() => { if (this.result === undefined) this.land(t.kind); }, gap * 2);
  },
  key(e) {
    const k = e.key.toLowerCase(), n = +e.key;
    if (n >= 1 && n <= DATA.genera.length) { this.setG(DATA.genera[n - 1].id); return true; }
    const r = 'qwe'.indexOf(k); if (r >= 0 && DATA.shapes[r]) { this.setS(DATA.shapes[r].id); return true; }
    if ((k === 'a' || k === 'b') && this.shared && this.result === undefined) { const x = this.shared['ab'.indexOf(k)]; if (x) this.land(x.id); return true; }
    if (k === 'y') { this.done('wu7'); return true; }
    if (e.key === 'Enter' && this.result) { this.done(null); return true; }
    if (e.key === 'Backspace') { this.reset(); steps(0); return true; }
  }
};
document.addEventListener('click', e => { const c = e.target.closest('.cell'); if (c && !c.classList.contains('none')) { V.g = null; V.setG(c.dataset.g); V.setS(c.dataset.s); } });
boot(V);
