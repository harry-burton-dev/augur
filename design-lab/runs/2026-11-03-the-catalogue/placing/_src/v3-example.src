/*@meta {"n":3,"title":"Like this one","cap":"place it by example: pick what it is most like, then hold it up detail by detail · herbarium type specimens, Rosch's prototypes, the paint chip held to the wall"}*/
/*@css*/
.grid{position:absolute;inset:0;display:grid;grid-template-columns:minmax(0,1fr) var(--x-col-side);gap:var(--space-5)}
.left{display:flex;flex-direction:column;gap:var(--space-4);min-height:0}
.shelf h2,.cmp h2{margin:0 0 var(--space-2);font:300 var(--type-lead)/var(--leading-lead) var(--font-sans);color:var(--light)}
.shelf .hint{font-size:var(--type-small);color:var(--ink-muted);margin:calc(var(--space-1) * -1) 0 var(--space-3)}
.specs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-2)}
.spec{position:relative;padding:var(--space-2) var(--space-3);border:1px solid var(--hairline);border-radius:var(--radius-inset);background:var(--surface-inset);transition:opacity var(--motion-slow) var(--ease-standard),border-color var(--motion-base) var(--ease-standard),background var(--motion-base) var(--ease-standard)}
.spec:hover{border-color:var(--hairline-strong)}
.spec .n{display:flex;align-items:baseline;gap:var(--space-2);color:var(--light)}
.spec .n .ix{font:400 var(--x-type-micro)/1 var(--font-mono);color:var(--ink-muted)}
.spec .kind{font-size:var(--type-small);color:var(--ink-muted);margin-top:calc(var(--space-1) / 2)}
.spec .kind svg{width:var(--space-3);height:var(--space-3)}
.spec .d{margin-top:var(--space-1);font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.spec.on{border-color:var(--x-accent);background:var(--x-accent-soft)}
.shelf.picked .spec:not(.on){opacity:.5}
.shelf.picked .spec .d,.shelf.picked .spec .kind{display:none}
.shelf.picked .spec{padding:var(--space-1) var(--space-3)}
.cmp{flex:1;min-height:0}
.cmp .rows{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1fr) minmax(0,1.3fr);border-top:1px solid var(--hairline-strong)}
.cmp .rows > div{padding:var(--space-2) var(--space-3);border-bottom:1px solid var(--hairline);font-size:var(--type-meta);line-height:var(--leading-meta);min-height:calc(var(--target-sm) + var(--space-1));display:flex;align-items:center;gap:var(--space-2)}
.cmp .hd{font:400 var(--x-type-micro)/var(--leading-small) var(--font-mono) !important;letter-spacing:var(--tracking-caps);text-transform:uppercase;color:var(--ink-muted);min-height:0 !important}
.cmp .dk{color:var(--ink-muted)}
.cmp .ex{color:var(--ink)}
.cmp .mk{transition:opacity var(--motion-base) var(--ease-out)}
.cmp .mk.pre{opacity:0}
.cmp .mk svg{width:var(--space-4);height:var(--space-4);flex:none}
.cmp .mk.has{color:var(--light)}
.cmp .mk.has svg{color:var(--success)}
.cmp .mk.gapm .gap{padding:var(--space-1) var(--space-2) !important;flex-direction:row;flex-wrap:wrap;column-gap:var(--space-2);font-size:var(--type-small);line-height:var(--leading-small)}
.cmp .mk.not{color:var(--ink-muted)}
.cmp .mk.not span{text-decoration:line-through;text-decoration-color:var(--x-gap-edge)}
.cmp .mk.not svg{color:var(--danger)}
.verdict{margin-top:var(--space-3);display:flex;align-items:center;gap:var(--space-3);padding:var(--space-3) var(--space-4);border-radius:var(--radius-inset);border:1px solid var(--x-accent-edge);background:var(--x-accent-soft)}
.verdict svg{width:var(--space-5);height:var(--space-5);color:var(--x-accent);flex:none}
.verdict b{font-weight:300;font-size:var(--type-lead);color:var(--light);display:block}
.verdict span{font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink)}
.verdict.no{border-style:dashed;border-color:var(--x-gap-edge);background:var(--surface-inset)}
.verdict.no svg{color:var(--ink-muted)}
.right{display:flex;flex-direction:column;gap:var(--space-3);min-height:0;overflow:auto;scrollbar-width:thin}
.right .idle{color:var(--ink-muted);font-size:var(--type-small);line-height:var(--leading-small);border:1px dashed var(--hairline-strong);border-radius:var(--radius-inset);padding:var(--space-3) var(--space-4)}
@media (max-height:840px){.said p{display:none}.left{gap:var(--space-3)}.cmp .rows > div{min-height:var(--target-sm);padding:var(--space-1) var(--space-3)}.shelf.picked .spec .kind{display:none}}
/*@html*/
<div class="grid">
  <div class="left">
    <div id="thing"></div>
    <section class="shelf" id="shelf"></section>
    <section class="cmp" id="cmp" aria-live="polite"></section>
  </div>
  <aside class="right" id="right" aria-live="polite"></aside>
</div>
/*@js*/
const E = id => DATA.entities[id];
const V = {
  title: 'Add a thing', sub: 'Pick something we already keep that it’s most like. Hold yours up to it, detail by detail. If every detail could apply, it’s the same kind. <b>Then it goes to Triage.</b>',
  keys() { return [['1–6', 'pick an example'], ['⌫', 'pick again'], ['Y', 'that’s it'], ['Enter', 'it’s new']]; },
  reset() { this.pick = null; this.result = undefined; $('#thing').innerHTML = thingCard(); this.shelf(); $('#cmp').innerHTML = ''; $('#right').innerHTML = `<div class="idle">Your example decides the kind. Once it does, things we already keep that look like yours show here, so nothing is kept twice.</div>`; },
  shelf() {
    const s = $('#shelf'); s.classList.toggle('picked', !!this.pick); $('#thing').hidden = !!this.pick;
    s.innerHTML = `<h2>${this.pick ? 'Held up against' : 'What is it most like?'}${st(W('example')[1])}</h2>${this.pick ? '' : '<p class="hint">One example of each kind we keep, from your floor. Choose the nearest, even if it’s not close.</p>'}
      <div class="specs">${DATA.examples.map((id, i) => { const e = E(id), k = K(e.kind), d = Object.entries(e.d).slice(0, 2);
        return `<button class="spec${this.pick === id ? ' on' : ''}" data-ex="${id}"><span class="n"><span class="ix">${i + 1}</span>${e.name}</span><span class="kind">${ic(k.icon)}<span>${k.word}</span></span>
          <span class="d">${d.map(([a, b]) => `${a}: ${b}`).join(' · ')}</span></button>`; }).join('')}</div>`;
  },
  choose(id) {
    clearLater(); this.pick = id; this.result = undefined; this.shelf(); steps(1);
    const e = E(id), k = K(e.kind), t = DATA.things[MODE];
    const mark = h => {
      const tw = t.tryOn && t.tryOn[k.id]; const a = tw && h in tw ? tw[h] : (t.known && t.known[h]) || (k.id === t.kind ? null : false);
      if (a === false) return `<div class="mk not pre">${ic('x')}<span>Doesn’t have one</span></div>`;
      if (a) return `<div class="mk has pre">${ic('check')}${a}</div>`;
      const who = t.gaps && t.gaps[h];
      return `<div class="mk gapm pre"><span class="gap"><span>It has one, not known yet:</span><span>${who ? `<b>${who}</b> could fill it` : 'Triage will ask'}</span></span></div>`;
    };
    $('#cmp').innerHTML = `<h2>Does ${t.said} have what ${e.name} has?</h2><div class="rows"><div class="hd">Detail${st(W('detail')[1])}</div><div class="hd">${e.name}</div><div class="hd">${t.said}</div>
      ${k.has.map(h => `<div class="dk">${h}</div><div class="ex">${e.d[h] || '—'}</div>${mark(h)}`).join('')}</div><div id="verdict"></div>`;
    Icons.hydrate($('#cmp'));
    const mks = $$('.mk.pre', $('#cmp'));
    mks.forEach((m, i) => later(() => m.classList.remove('pre'), ms('--motion-slow') * (i + 1)));
    later(() => this.verdict(e, k, mks), ms('--motion-slow') * (mks.length + 1));
  },
  verdict(e, k, mks) {
    const not = mks.filter(m => m.classList.contains('not')).length, v = $('#verdict');
    if (!not) {
      this.result = k.id;
      v.innerHTML = `<div class="verdict">${ic(k.icon)}<div><b>Same kind as ${e.name}: ${k.word}</b><span>Every detail ${e.name} has, yours could have. ${mks.filter(m => m.classList.contains('gapm')).length} aren’t known yet; they go with it as gaps.</span>${st(k.studio)}</div></div>`;
      $('#right').innerHTML = nearHTML(); steps(2);
    } else {
      this.result = null;
      const t = DATA.things[MODE];
      v.innerHTML = `<div class="verdict no">${ic('circle-dashed')}<div><b>Not really a ${k.word}: ${not} of ${mks.length} details don’t apply</b><span>No other example is closer, so nothing we keep fits. Your ask is worded from this: “${t.words}”.</span></div></div>`;
      $('#right').innerHTML = slipHTML(); steps(3, true);
    }
    Icons.hydrate(v); Icons.hydrate($('#right')); reveal(v.firstElementChild); reveal($('#right').firstElementChild);
  },
  done(same) { if (MODE !== 'fits' || !this.result) return; $('#right').innerHTML = slipHTML(this.result, same); steps(3); reveal($('#right').firstElementChild); },
  demo() { steps(1); this.choose(DATA.things[MODE].like); },
  key(e) {
    const n = +e.key; if (n >= 1 && n <= DATA.examples.length) { this.choose(DATA.examples[n - 1]); return true; }
    if (e.key === 'Backspace') { clearLater(); this.reset(); steps(0); return true; }
    if (e.key.toLowerCase() === 'y') { this.done('wu7'); return true; }
    if (e.key === 'Enter' && this.result) { this.done(null); return true; }
  }
};
document.addEventListener('click', e => { const b = e.target.closest('[data-ex]'); if (b) V.choose(b.dataset.ex); });
boot(V);
