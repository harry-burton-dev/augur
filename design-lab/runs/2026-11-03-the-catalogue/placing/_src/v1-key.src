/*@meta {"n":1,"title":"The key","cap":"a dichotomous key, the whole page visible, leader dots to the next couplet · Lamarck's Flore françoise (1778), Collins field guides, FSC fold-out keys"}*/
/*@css*/
.grid{position:absolute;inset:0;display:grid;grid-template-columns:minmax(0,1fr) var(--x-col-side);gap:var(--space-5)}
.left{display:flex;flex-direction:column;gap:var(--space-4);min-height:0}
.keypage{position:relative;flex:1;min-height:0;border-top:1px solid var(--hairline-strong);padding-top:var(--space-3)}
.keypage .kh{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:var(--space-2)}
.keypage .kh .note{font-size:var(--type-small);color:var(--ink-muted)}
.cp{display:grid;grid-template-columns:var(--space-6) minmax(0,1fr);column-gap:var(--space-2);padding:calc(var(--space-1) / 2) 0;border-radius:var(--radius-key);transition:opacity var(--motion-slow) var(--ease-standard),background var(--motion-slow) var(--ease-standard)}
.cp .no{font:300 var(--type-lead)/1 var(--font-sans);color:var(--ink-muted);padding-top:var(--space-1);text-align:right;padding-right:var(--space-2)}
.ld{display:grid;grid-template-columns:var(--space-4) auto minmax(var(--space-5),1fr) auto;align-items:baseline;gap:var(--space-2);width:100%;min-height:calc(var(--space-5) + var(--space-1));padding:0 var(--space-2);border-radius:var(--radius-key);font-size:var(--type-meta);color:var(--ink)}
.ld .ab{font:400 var(--x-type-micro)/1 var(--font-mono);color:var(--ink-muted)}
.ld .dots{align-self:center;height:1px;background-image:radial-gradient(circle,var(--ink-muted) 0.6px,transparent 0.8px);background-size:var(--space-2) 2px;background-repeat:repeat-x;opacity:.7}
.ld .to{font:400 var(--type-small)/1 var(--font-mono);color:var(--ink-muted);display:inline-flex;gap:var(--space-2);align-items:center;white-space:nowrap}
.ld .to svg{width:var(--space-4);height:var(--space-4);color:var(--x-accent)}
.ld .to.kindto{font-family:var(--font-sans);font-size:var(--type-meta);color:var(--ink)}
.ld .to.none{border:1px dashed var(--x-gap-edge);border-radius:var(--radius-key);padding:var(--space-1) var(--space-2);font-family:var(--font-sans)}
.cp.past{opacity:.55}
.cp.off{opacity:var(--x-out)}
.cp.now{background:var(--surface-raised);box-shadow:inset 2px 0 0 var(--x-accent);opacity:1}
.cp.now .no{color:var(--x-accent)}
.cp.now .ld:hover{background:var(--surface-overlay)}
.ld.took{color:var(--light)}
.ld.took .ab{color:var(--x-accent)}
.ld.took .dots{background-image:radial-gradient(circle,var(--x-accent) 0.8px,transparent 1px);opacity:1}
.ld.left .ab{text-decoration:line-through}
.trail{font:400 var(--type-small)/1 var(--font-mono);color:var(--ink-muted);display:flex;gap:var(--space-2);align-items:center}
.trail b{color:var(--x-accent);font-weight:400}
.right{display:flex;flex-direction:column;gap:var(--space-3);min-height:0;overflow:hidden}
.poss h3{margin:0 0 var(--space-2);font:300 var(--type-lead)/var(--leading-lead) var(--font-sans);color:var(--light)}
.poss .row{display:flex;justify-content:space-between;align-items:center;height:var(--target-sm);border-bottom:1px solid var(--hairline);transition:opacity var(--motion-slow) var(--ease-standard)}
.poss .row.out{opacity:var(--x-out)}
.poss .row.out .kind span:nth-child(2){text-decoration:line-through;text-decoration-color:var(--ink-muted)}
.poss .row .r{font-size:var(--type-small);color:var(--ink-muted)}
.poss .elsew{margin-top:var(--space-3);font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink-muted);display:flex;gap:var(--space-2)}
.poss .elsew svg{width:var(--space-4);height:var(--space-4);flex:none}
.res{border:1px solid var(--x-accent-edge);border-radius:var(--radius-inset);padding:var(--space-3) var(--space-4);background:var(--x-accent-soft)}
.res .big{display:flex;align-items:center;gap:var(--space-3);font:300 var(--type-heading)/var(--leading-heading) var(--font-sans);color:var(--light)}
.res .big svg{width:var(--space-5);height:var(--space-5);color:var(--x-accent)}
.res p{margin:var(--space-1) 0 0;font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink)}
.res.none{border-style:dashed;border-color:var(--x-gap-edge);background:var(--surface-inset)}
.res.none .big svg{color:var(--ink-muted)}
@media (max-height:840px){.ld{min-height:var(--space-5)}.cp{padding:0}.said p{display:none}.left{gap:var(--space-3)}}
/*@html*/
<div class="grid">
  <div class="left">
    <div id="thing"></div>
    <div class="keypage">
      <div class="kh"><span class="micro">Key to the kinds of thing we keep<span class="st">decision tree over class axioms</span></span><span class="note">Choose a or b. The number says where to go next.</span></div>
      <div id="key" role="list"></div>
    </div>
  </div>
  <aside class="right" id="right" aria-live="polite"></aside>
</div>
/*@js*/
const V = {
  title: 'Add a thing', sub: 'Answer the key, a or b, the way a field guide works. It ends at a kind of thing, or tells you none fits yet. <b>Then it goes to Triage.</b>',
  at: 1, path: [], result: undefined,
  keys() { return [['A B', 'choose'], ['⌫', 'back a step'], ['Y', 'that’s it'], ['Enter', 'it’s new']]; },
  reset() { this.at = 1; this.path = []; this.result = undefined; $('#thing').innerHTML = thingCard(); this.draw(); },
  draw() {
    const onPath = new Map(this.path.map(p => [p.n, p.ab]));
    $('#key').innerHTML = DATA.key.map(c => {
      const cls = this.result === undefined && c.n === this.at ? 'now' : onPath.has(c.n) ? 'past' : (this.path.length ? 'off' : '');
      const lead = ab => { const [txt, to] = c[ab];
        const took = onPath.get(c.n) === ab, left = onPath.has(c.n) && !took;
        const dest = typeof to === 'number' ? `<span class="to">go to ${to}</span>`
          : to ? `<span class="to kindto">${ic(K(to).icon)}${K(to).word}${st(K(to).studio)}</span>` : `<span class="to none">no kind yet</span>`;
        return `<button class="ld${took ? ' took' : ''}${left ? ' left' : ''}" data-c="${c.n}" data-ab="${ab}" ${cls === 'now' ? '' : 'tabindex="-1"'}><span class="ab">${c.n}${ab}</span><span>${txt}</span><span class="dots"></span>${dest}</button>`; };
      return `<div class="cp ${cls}" role="listitem"><span class="no">${c.n}</span><div>${lead('a')}${lead('b')}</div></div>`;
    }).join('');
    this.side();
  },
  possible() {
    // kinds reachable from the current couplet
    const reach = new Set(); const walk = n => { const c = DATA.key.find(x => x.n === n); for (const ab of ['a', 'b']) { const to = c[ab][1]; if (typeof to === 'number') walk(to); else if (to) reach.add(to); else reach.add('?'); } };
    if (this.result === undefined) walk(this.at); return reach;
  },
  side() {
    const r = $('#right');
    if (this.result === undefined) {
      const reach = this.possible();
      r.innerHTML = `<div class="poss"><h3>Still possible</h3>${DATA.kinds.map(k => `<div class="row${reach.has(k.id) ? '' : ' out'}">${kindChip(k)}<span class="r">${reach.has(k.id) ? '' : 'ruled out'}</span></div>`).join('')}
        <div class="elsew">${ic('file-text')}<span>Written down? A report, a letter or a form is kept in <b>Artifacts</b>. Data Atlas keeps what it’s about.</span></div>
        <p class="trail" style="margin-top:var(--space-3)">${this.path.length ? 'Your way through: ' + this.path.map(p => `<b>${p.n}${p.ab}</b>`).join(' → ') : ''}</p></div>`;
      return;
    }
    const trail = `<p class="trail">Your way through: ${this.path.map(p => `<b>${p.n}${p.ab}</b>`).join(' → ')}</p>`;
    if (this.result) {
      const k = K(this.result);
      r.innerHTML = `<div class="res"><div class="micro">It keys out as</div><div class="big">${ic(k.icon)}${k.word}</div>${st(k.studio)}<p>${k.says} We keep ${fmt(k.n)}.</p></div>${trail}<div id="nr">${nearHTML()}</div>`;
      steps(2); reveal($('#nr'));
    } else {
      const t = DATA.things.misfit, p = DATA.predicted.find(x => x.genus === t.genus && x.shape === t.shape);
      r.innerHTML = `<div class="res none"><div class="micro">The key ends at</div><div class="big">${ic('circle-dashed')}No kind yet</div><p>Nothing we keep ${p.diff}. The key says so, rather than making it fit.</p></div>${trail}<div id="nr">${slipHTML()}</div>`;
      steps(3, true); reveal($('#nr'));
    }
    Icons.hydrate(r);
  },
  choose(ab) {
    if (this.result !== undefined) return;
    const c = DATA.key.find(x => x.n === this.at), to = c[ab][1];
    this.path.push({ n: c.n, ab });
    if (typeof to === 'number') { this.at = to; steps(1); } else this.result = to;
    this.draw();
    const now = $('.cp.now .ld'); if (now) now.focus({ preventScroll: true });
  },
  back() { if (!this.path.length) return; const p = this.path.pop(); this.at = p.n; this.result = undefined; steps(this.path.length ? 1 : 0); this.draw(); },
  done(same) { if (MODE !== 'fits' || !this.result) return; $('#nr').innerHTML = slipHTML(this.result, same); steps(3); reveal($('#nr')); },
  demo() {
    steps(1);
    const path = DATA.things[MODE].keyPath;
    path.forEach((p, i) => later(() => this.choose(p.slice(-1)), ms('--motion-calm') * i));
  },
  key(e) {
    const k = e.key.toLowerCase();
    if (k === 'a' || k === 'b') { this.choose(k); return true; }
    if (e.key === 'Backspace') { this.back(); return true; }
    if (k === 'y') { this.done('wu7'); return true; }
    if (e.key === 'Enter' && this.result) { this.done(null); return true; }
  }
};
document.addEventListener('click', e => { const l = e.target.closest('.cp.now .ld'); if (l) V.choose(l.dataset.ab); });
boot(V);
