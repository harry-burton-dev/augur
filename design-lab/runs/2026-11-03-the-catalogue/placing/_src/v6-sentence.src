/*@meta {"n":6,"title":"A ___ that ___","cap":"say it as one sentence: what it is, what sets it apart, what it's linked to; the sentence is the definition · Aristotle's genus and differentia, Linnaean diagnoses, Mad Libs"}*/
/*@css*/
.grid{position:absolute;inset:0;display:grid;grid-template-columns:minmax(0,1fr) var(--x-col-side);gap:var(--space-5)}
.left{display:flex;flex-direction:column;gap:var(--space-4);min-height:0}
.said p{display:none}
.sent{position:relative;font:200 var(--type-title-s)/calc(var(--leading-title-s) + var(--space-3)) var(--font-sans);color:var(--ink-muted);letter-spacing:var(--tracking-tight)}
.sent .subj{color:var(--light)}
.slot{position:relative;display:inline-block;min-width:calc(var(--space-7) + var(--space-5));padding:0 var(--space-1);border-bottom:2px dashed var(--hairline-strong);color:var(--ink-muted);border-radius:var(--radius-key) var(--radius-key) 0 0;transition:background var(--motion-base) var(--ease-standard),border-color var(--motion-base) var(--ease-standard),color var(--motion-base) var(--ease-standard)}
.slot.on{background:var(--x-accent-soft);border-bottom-color:var(--x-accent);color:var(--ink)}
.slot.set{border-bottom:2px solid var(--x-accent-edge);color:var(--light)}
.slot.gapw{border-bottom:2px dashed var(--x-wait);color:var(--x-wait)}
.slot .lab{position:absolute;left:var(--space-2);top:calc(var(--space-3) * -1);font:400 var(--x-type-micro)/1 var(--font-mono);letter-spacing:var(--tracking-caps);text-transform:uppercase;color:var(--ink-muted);white-space:nowrap}
.opts{position:absolute;z-index:3;left:0;top:calc(100% + var(--space-1));min-width:calc(var(--measure-card) - var(--space-5));padding:var(--space-1);border:1px solid var(--hairline-strong);border-radius:var(--radius-inset);background:var(--surface-overlay);-webkit-backdrop-filter:blur(var(--surface-blur));backdrop-filter:blur(var(--surface-blur));box-shadow:var(--shadow-overlay);font:400 var(--type-meta)/var(--leading-meta) var(--font-sans);letter-spacing:0}
.opt{display:grid;grid-template-columns:var(--space-4) minmax(0,1fr) auto;gap:var(--space-2);align-items:center;width:100%;padding:var(--space-1) var(--space-2);border-radius:var(--radius-key);color:var(--ink)}
.opt .kbd{justify-self:start}
.opt .r{font-size:var(--type-small);color:var(--ink-muted);white-space:nowrap}
.opt:hover,.opt.hl{background:var(--surface-raised)}
.opt.pred{color:var(--ink-muted)}
.opt.pred .r{color:var(--x-wait)}
.opt.ext .r{color:var(--ink-muted)}
.reads{display:grid;grid-template-columns:auto minmax(0,1fr);gap:var(--space-2) var(--space-4);padding-top:var(--space-3);border-top:1px solid var(--hairline);font-size:var(--type-meta);line-height:var(--leading-meta)}
.reads dt{font:400 var(--x-type-micro)/var(--leading-meta) var(--font-mono);letter-spacing:var(--tracking-caps);text-transform:uppercase;color:var(--ink-muted)}
.reads dd{margin:0;color:var(--ink)}
.reads dd .m{color:var(--ink-muted)}
.reads code{font:400 var(--type-small)/var(--leading-small) var(--font-mono);color:var(--ink-muted)}
.right{display:flex;flex-direction:column;gap:var(--space-3);min-height:0;overflow:auto;scrollbar-width:thin}
.right .idle{color:var(--ink-muted);font-size:var(--type-small);line-height:var(--leading-small);border:1px dashed var(--hairline-strong);border-radius:var(--radius-inset);padding:var(--space-3) var(--space-4)}
.ss{display:block;width:100%;border:1px solid var(--hairline);border-radius:var(--radius-inset);background:var(--surface-inset);padding:var(--space-2) var(--space-3);margin-bottom:var(--space-2);font-size:var(--type-meta);line-height:var(--leading-meta);color:var(--ink-muted)}
.ss b{font-weight:400;color:var(--light)}
.ss em{font-style:normal;color:var(--ink)}
.ss del{color:var(--ink-muted);text-decoration-color:var(--danger)}
.ss ins{text-decoration:none;color:var(--x-accent)}
.ss.lead{border-color:var(--x-accent-edge);background:var(--surface-raised)}
.ss .where{display:block;margin-top:var(--space-1);font-size:var(--type-small);line-height:var(--leading-small)}
.ss .acts{margin-top:var(--space-2);display:flex;gap:var(--space-2)}
.ss .acts .btn{height:calc(var(--space-5) + var(--space-1));font-size:var(--type-small)}
@media (max-height:840px){.sent{font-size:var(--type-heading);line-height:calc(var(--leading-heading) + var(--space-3))}.left{gap:var(--space-3)}}
/*@html*/
<div class="grid">
  <div class="left">
    <div id="thing"></div>
    <div class="sent" id="sent" aria-live="polite"></div>
    <dl class="reads" id="reads"></dl>
  </div>
  <aside class="right" id="right" aria-live="polite"></aside>
</div>
/*@js*/
const lc = s => s.charAt(0).toLowerCase() + s.slice(1);
const V = {
  title: 'Add a thing', sub: 'Say it as one sentence: <i>it’s a ___ that ___</i>. The first blank is what it is, the second what sets it apart; together they name its kind. Extra clauses become links. <b>Then it goes to Triage.</b>',
  keys() { return [['1–7', 'fill the blank'], ['⌫', 'back a blank'], ['Y', 'that’s it'], ['Enter', 'it’s new']]; },
  reset() { this.g = null; this.d = null; this.links = 0; this.at = 0; this.result = undefined; $('#thing').innerHTML = thingCard(); this.draw(); $('#right').innerHTML = `<div class="idle">When the sentence names a kind, things we already keep are shown as sentences too, so you can see if one says the same as yours.</div>`; },
  optsG() { return DATA.genera.map(g => ({ id: g.id, w: g.a, r: `${DATA.kinds.filter(k => k.genus === g.id).length} kinds` }))
      .concat(DATA.elsewhere.filter(e => e.id === 'document').map(e => ({ id: 'doc', w: 'something written down', r: `kept in ${e.app}`, ext: true }))); },
  optsD() { const g = this.g; return DATA.kinds.filter(k => k.genus === g).map(k => ({ id: k.id, w: k.diff, r: k.word }))
      .concat(DATA.predicted.filter(p => p.genus === g).map(p => ({ id: 'pred:' + p.word, w: p.diff, r: 'no kind yet', pred: true }))); },
  draw() {
    const t = DATA.things[MODE], gw = this.g ? G(this.g).a : '', dOpt = this.d && this.optsD().find(o => o.id === this.d);
    const slot = (i, label, val, cls) => `<span class="slot${this.at === i ? ' on' : ''}${val ? ' set' : ''}${cls || ''}" data-slot="${i}"><span class="lab">${label}${st(i === 0 ? W('genus')[1] : i === 1 ? W('diff')[1] : W('link')[1])}</span>${val || '&nbsp;'}${this.at === i && this.result === undefined ? this.optsHTML(i) : ''}</span>`;
    let h = `<span class="subj">${t.said}</span> is ${slot(0, 'what it is', gw)} that ${slot(1, 'what sets it apart', dOpt ? dOpt.w : '', dOpt && dOpt.pred ? ' gapw' : '')}`;
    if (this.links) h += t.links.slice(0, this.links).map(l => `, and <span class="slot set"><span class="lab">link</span>${l[0]} ${l[1]}</span>`).join('');
    $('#sent').innerHTML = h.replace(/<\/span>,/g, '</span>,');
    const k = dOpt && !dOpt.pred ? K(dOpt.id) : null;
    $('#reads').innerHTML = `<dt>Reads as</dt><dd>${k ? `${kindChip(k)}` : dOpt ? `<span style="color:var(--x-wait)">a kind we don’t keep yet: “${dOpt.w}”</span>` : '<span class="m">fill both blanks to name its kind</span>'}</dd>
      ${k ? `<dt>Its details</dt><dd><div class="det" style="margin:0;max-width:var(--measure-read)">${detRows(k, t)}</div></dd>` : ''}
      <dt>Links</dt><dd>${this.links ? t.links.slice(0, this.links).map(l => `${l[0]} <b style="font-weight:400;color:var(--light)">${l[1]}</b>`).join(' · ') : '<span class="m">none yet: optional</span>'}</dd>
      ${document.body.classList.contains('studio') && k ? `<dt>Studio</dt><dd><code>${t.said.replace(/\s+/g, '_')} a ${k.studio.replace(/\s+/g, '')}${t.links.slice(0, this.links).map(l => ` ; ${l[0].replace(/\s+(\w)/g, (m, c) => c.toUpperCase())} ${l[1].replace(/\s+/g, '_')}`).join('')} .</code></dd>` : ''}`;
    Icons.hydrate($('#sent')); Icons.hydrate($('#reads'));
  },
  optsHTML(i) {
    const o = i === 0 ? this.optsG() : this.optsD();
    return `<span class="opts" role="listbox">${o.map((x, j) => `<button class="opt${x.pred ? ' pred' : ''}${x.ext ? ' ext' : ''}" data-o="${j}"><span class="kbd">${j + 1}</span><span>${x.w}</span><span class="r">${x.r}</span></button>`).join('')}</span>`;
  },
  choose(j) {
    if (this.result !== undefined) return;
    const o = (this.at === 0 ? this.optsG() : this.optsD())[j]; if (!o) return;
    steps(1);
    if (this.at === 0) { if (o.ext) { $('#right').innerHTML = `<div class="idle">Written things are kept in Artifacts. Add it there; Data Atlas will keep what it’s about.</div>`; return; } this.g = o.id; this.at = 1; this.draw(); return; }
    this.d = o.id; this.at = 2; this.draw();
    if (o.pred) { this.result = null; this.draw(); $('#right').innerHTML = slipHTML(); steps(3, true); }
    else { this.result = o.id; this.draw(); later(() => { this.links = 1; this.draw(); }, ms('--motion-slow')); $('#right').innerHTML = this.nearSentences(); steps(2); }
    Icons.hydrate($('#right')); reveal($('#right').firstElementChild);
  },
  nearSentences() {
    const k = K(this.result), t = DATA.things[MODE];
    return `<div class="near"><h3>Is it one of these?${st(W('near')[1])}</h3><p class="why">Things we keep, said the same way. Where they differ from yours is marked. ${DATA.matching.note}</p>
      ${DATA.near.fits.map((n, i) => { const nk = K(n.kind);
        return `<div class="ss${n.lead ? ' lead' : ''}"><b>${n.name}</b> is ${G(nk.genus).a} that ${nk.id === k.id ? `<em>${nk.diff}</em>` : `<del>${k.diff}</del> <ins>${nk.diff}</ins>`}${n.diff[0] && nk.id === k.id ? `, and <del>${lc(n.diff[0])}</del>` : ''}.
          <span class="where">${n.where}</span>${n.lead ? `<div class="acts"><button class="btn go" data-same="${n.id}">That’s it: add to it <span class="kbd">Y</span></button></div>` : ''}</div>`; }).join('')}
      <button class="btn" data-new>None of these: it’s new <span class="kbd">Enter</span></button></div>`;
  },
  onStudio() { this.draw(); },
  back() { if (this.at === 0) return; if (this.at >= 1) { this.result = undefined; this.links = 0; } if (this.at === 2) { this.d = null; this.at = 1; } else { this.g = null; this.at = 0; } steps(1); this.draw(); },
  done(same) { if (MODE !== 'fits' || !this.result) return; $('#right').innerHTML = slipHTML(this.result, same); steps(3); reveal($('#right').firstElementChild); },
  demo() {
    const t = DATA.things[MODE], gap = ms('--motion-calm');
    steps(1); this.draw();
    later(() => this.choose(this.optsG().findIndex(o => o.id === t.genus)), gap);
    later(() => this.choose(this.optsD().findIndex(o => t.kind ? o.id === t.kind : o.pred && o.w === DATA.predicted.find(p => p.genus === t.genus && p.shape === t.shape).diff)), gap * 2.5);
  },
  key(e) {
    const n = +e.key; if (n >= 1 && n <= 9) { this.choose(n - 1); return true; }
    if (e.key === 'Backspace') { this.back(); return true; }
    if (e.key.toLowerCase() === 'y') { this.done('wu7'); return true; }
    if (e.key === 'Enter' && this.result) { this.done(null); return true; }
  }
};
document.addEventListener('click', e => { const o = e.target.closest('[data-o]'); if (o) V.choose(+o.dataset.o); });
boot(V);
