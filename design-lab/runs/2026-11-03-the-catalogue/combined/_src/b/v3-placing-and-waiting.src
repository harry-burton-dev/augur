/*@meta {"n":3,"title":"Placing and waiting","cap":"placing and waiting: questions fill a sentence; what fits nothing waits on a predicted slot · twenty questions, genus and differentia, Mendeleev"}*/
/*@css*/
/* ---------- operator: placing ---------- */
.op{position:absolute;inset:0;display:grid;grid-template-columns:minmax(0,1fr) var(--x-side);gap:var(--space-5)}
.left{display:flex;flex-direction:column;gap:var(--space-4);min-height:0;min-width:0}
.said{display:flex;align-items:baseline;gap:var(--space-3);flex-wrap:wrap;padding-bottom:var(--space-3);border-bottom:1px solid var(--hairline)}
.said .w{font:300 var(--type-lead)/var(--leading-lead) var(--font-sans);color:var(--light)}
.said .n{font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink-muted)}
.said svg{width:var(--space-3);height:var(--space-3);vertical-align:-1px;margin-right:var(--space-1)}
.sent{font:200 var(--type-title-s)/calc(var(--leading-title-s) + var(--space-4)) var(--font-sans);color:var(--ink-muted);letter-spacing:var(--tracking-tight);padding-top:var(--space-3)}
.sent .subj{color:var(--light)}
.slot{position:relative;display:inline-block;min-width:calc(var(--space-7) + var(--space-6));padding:0 var(--space-1);border-bottom:2px dashed var(--hairline-strong);color:var(--ink-muted);transition:color var(--motion-calm) var(--ease-out),border-color var(--motion-calm) var(--ease-out),background var(--motion-calm) var(--ease-out)}
.slot.set{border-bottom:2px solid var(--x-accent-edge);color:var(--light)}
.slot.fresh{background:var(--x-accent-soft)}
.slot.wait{border-bottom:2px dashed var(--x-proposed-wait);color:var(--x-proposed-wait)}
.slot .lab{position:absolute;left:var(--space-1);top:calc(var(--space-3) * -1);font:400 var(--x-proposed-type-micro)/1 var(--font-mono);letter-spacing:var(--tracking-caps);text-transform:uppercase;color:var(--ink-muted);white-space:nowrap}
.slot .lab .tk{display:none}
body.tech .slot .lab .tk{display:inline}
/* the question */
.qbox{border:1px solid var(--hairline-strong);border-radius:var(--radius-inset);background:var(--surface-pane);padding:var(--space-3) var(--space-4)}
.qbox .q{font:300 var(--type-lead)/var(--leading-lead) var(--font-sans);color:var(--light);margin:var(--space-1) 0 var(--space-1)}
.qbox .split{font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink-muted);margin-bottom:var(--space-3)}
.qbox .acts{display:flex;gap:var(--space-2)}
.trail{display:flex;flex-wrap:wrap;gap:var(--space-1) var(--space-2);font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink-muted)}
.trail span{padding:0 var(--space-2);border:1px solid var(--hairline);border-radius:var(--radius-pill)}
.trail span b{color:var(--ink)}
.poss{display:flex;flex-wrap:wrap;gap:var(--space-2)}
.poss .pk{display:inline-flex;flex-direction:column;gap:0;padding:var(--space-1) var(--space-2);border:1px solid var(--hairline);border-radius:var(--radius-key);font-size:var(--type-small);line-height:var(--leading-small);transition:opacity var(--motion-calm) var(--ease-out),border-color var(--motion-calm)}
.poss .pk .kind svg{width:var(--space-3);height:var(--space-3)}
.poss .pk .r{font-size:var(--x-proposed-type-micro);color:var(--ink-muted)}
.poss .pk.out{opacity:var(--x-proposed-far)}
.poss .pk.left1{border-color:var(--x-accent-edge);background:var(--x-accent-soft)}
.poss .pk.pred{border-style:dotted;border-color:var(--x-proposed-predicted);color:var(--ink-muted)}
.poss .pk.pred.hit{border-color:var(--x-proposed-wait);color:var(--x-proposed-wait)}
/* near matches, said as sentences */
.right{display:flex;flex-direction:column;gap:var(--space-2);min-height:0;overflow:auto;scrollbar-width:thin}
.right h3,.res h3{margin:0;font:300 var(--type-lead)/var(--leading-lead) var(--font-sans);color:var(--light)}
.right .why{margin:0 0 var(--space-1);font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink-muted)}
.ss{border:1px solid var(--hairline);border-radius:var(--radius-inset);background:var(--surface-inset);padding:var(--space-2) var(--space-3);font-size:var(--type-meta);line-height:var(--leading-meta);color:var(--ink-muted);transition:opacity var(--motion-calm) var(--ease-out),border-color var(--motion-calm) var(--ease-out)}
.ss .nm{color:var(--light)}
.ss .fit{color:var(--ink)}
.ss .meta{display:block;margin-top:var(--space-1);font-size:var(--type-small);line-height:var(--leading-small)}
.ss .meta .y{color:var(--ink)}
.ss .meta svg{width:var(--space-3);height:var(--space-3);vertical-align:-2px;margin-right:var(--space-1)}
.ss .badge{display:inline-flex;align-items:center;gap:var(--space-1);margin-bottom:var(--space-1);font:400 var(--x-proposed-type-micro)/1 var(--font-mono);letter-spacing:var(--tracking-caps);text-transform:uppercase;color:var(--x-proposed-wait)}
.ss .badge svg{width:var(--space-3);height:var(--space-3)}
.ss.dup{border-color:color-mix(in srgb,var(--x-proposed-wait) 45%,transparent);background:var(--surface-raised)}
.ss.out{opacity:var(--x-proposed-far)}
.ss.out .why-out{color:var(--ink)}
.ss .acts{display:flex;gap:var(--space-2);margin-top:var(--space-2);flex-wrap:wrap}
/* results */
.res{border:1px solid var(--hairline-strong);border-radius:var(--radius-inset);background:var(--surface-pane);padding:var(--space-3) var(--space-4);display:flex;flex-direction:column;gap:var(--space-2);min-height:0;overflow:auto;scrollbar-width:thin}
.stamp{display:inline-flex;align-items:center;gap:var(--space-2);font:400 var(--x-proposed-type-micro)/1 var(--font-mono);letter-spacing:var(--tracking-caps);text-transform:uppercase;color:var(--x-accent)}
.stamp svg{width:var(--space-3);height:var(--space-3)}
.res.waiting .stamp{color:var(--x-proposed-wait)}
.res.waiting{border-color:color-mix(in srgb,var(--x-proposed-wait) 40%,transparent)}
.res .row{display:flex;align-items:baseline;justify-content:space-between;gap:var(--space-3)}
.res p{margin:0;font-size:var(--type-meta);line-height:var(--leading-meta);color:var(--ink)}
.res p.m{font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink-muted)}
.res .rec{margin:0;font-size:var(--type-small);line-height:var(--leading-small)}
.res .rec > .k,.res .rec > .v{padding:var(--space-1) 0}
.rec .src.in{display:inline;margin-left:var(--space-2)}
.sent.done{font-size:var(--type-heading);line-height:calc(var(--leading-heading) + var(--space-5))}
.res .rec .e{padding-top:var(--space-1);padding-bottom:var(--space-1)}
.whoL{display:grid;align-content:start;grid-template-columns:var(--space-4) minmax(0,1fr);gap:var(--space-2) var(--space-2);font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink-muted)}
.whoL svg{width:var(--space-4);height:var(--space-4);color:var(--ink)}
.whoL b{color:var(--ink)}
.kept{display:grid;grid-template-columns:auto minmax(0,1fr);gap:var(--space-1) var(--space-4);font-size:var(--type-small);line-height:var(--leading-small);padding:var(--space-2) 0;border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline)}
.kept dt{font:400 var(--x-proposed-type-micro)/var(--leading-small) var(--font-mono);letter-spacing:var(--tracking-caps);text-transform:uppercase;color:var(--ink-muted)}
.kept dd{margin:0;color:var(--ink)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4)}

/* ---------- admin: the table of kinds, with what waits ---------- */
.adm{position:absolute;inset:0;display:grid;grid-template-columns:minmax(0,1fr) var(--x-side);gap:var(--space-5)}
.tbl{display:grid;grid-template-columns:calc(var(--space-7) + var(--space-6)) repeat(5,minmax(0,1fr));gap:var(--space-2);align-content:start;min-width:0}
.tbl .fh{font-size:var(--type-meta);color:var(--ink);padding-bottom:var(--space-1);border-bottom:1px solid var(--hairline-strong)}
.tbl .fh .tk{font-size:var(--x-proposed-type-micro)}
body.tech .tbl .fh .tk,body.tech .who-am .tk{display:block;margin-left:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tbl .rh{display:flex;flex-direction:column;justify-content:center;align-items:flex-end;text-align:right;gap:var(--space-1);font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink-muted);padding-right:var(--space-2);border-right:2px solid var(--fc,var(--hairline))}
.tbl .rh b{color:var(--ink)}
.tbl .rh.pr{border-right:2px dotted var(--x-proposed-predicted)}
.cell{display:flex;flex-direction:column;gap:var(--space-2);min-width:0}
.tile{position:relative;display:flex;flex-direction:column;gap:var(--space-1);padding:var(--space-2);border:1px solid var(--hairline);border-radius:var(--radius-key);background:var(--surface-inset);min-width:0;transition:opacity var(--motion-calm) var(--ease-out),border-color var(--motion-calm) var(--ease-out),background var(--motion-calm) var(--ease-out)}
.tile .t{display:flex;align-items:center;gap:var(--space-2);color:var(--ink);font-size:var(--type-meta);line-height:var(--leading-meta);min-width:0}
.tile .t span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tile .t svg{width:var(--space-4);height:var(--space-4);flex:none;color:var(--ink-muted)}
.tile .c{font:400 var(--type-small)/1 var(--font-mono);color:var(--ink-muted)}
.bar{display:flex;height:var(--space-1);border-radius:var(--radius-pill);overflow:hidden;background:var(--hairline)}
.bar i{display:block;background:color-mix(in srgb,var(--ink) 60%,transparent);transition:flex-grow var(--motion-calm) var(--ease-out)}
.tile.pred{border:1px dotted var(--x-proposed-predicted);background:transparent}
.tile.pred .t{color:var(--ink-muted)}
.tile.pred .c{color:var(--x-proposed-wait)}
.tile.pred.empty .c{color:var(--ink-muted)}
.tile .gath{display:flex;flex-direction:column;gap:2px;margin-top:var(--space-1)}
.tile .gath span{display:block;padding:0 var(--space-1);border-left:2px solid var(--x-proposed-wait);font-size:var(--x-proposed-type-micro);line-height:var(--leading-small);color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tile.sel{border-color:var(--x-accent);border-style:solid;background:var(--x-accent-soft)}
.tile.made{border-style:solid;border-color:var(--x-accent-edge);background:var(--surface-raised)}
.tile.made .t{color:var(--light)}
.tile.made .gath span{border-left-color:var(--x-accent)}
.adm.focus .tile:not(.sel):not(.made){opacity:var(--x-proposed-far)}
.adm.focus .tbl .note{opacity:var(--x-proposed-far)}
.tbl .note{grid-column:2 / -1;align-self:center;font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink-muted);padding:var(--space-2) var(--space-3);border:1px dashed var(--hairline);border-radius:var(--radius-key)}
.margin{grid-column:2 / -1;display:grid;grid-template-columns:1fr 1fr;gap:var(--space-2);margin-top:var(--space-2)}
.margin .tile{flex-direction:column}
.margin .tile .w{font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink-muted)}
/* the drawer: one slot, its waiting things, and the kind made from a sentence */
.drawer{display:flex;flex-direction:column;gap:var(--space-3);min-height:0;overflow:auto;scrollbar-width:thin;padding-right:var(--space-1)}
.drawer h2{margin:0;font:300 var(--type-heading)/var(--leading-heading) var(--font-sans);color:var(--light)}
.drawer .lede{margin:0;font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink-muted)}
.wt{padding:var(--space-2) 0;border-bottom:1px solid var(--hairline);font-size:var(--type-meta);line-height:var(--leading-meta);color:var(--ink-muted)}
.wt .nm{color:var(--light)}
.wt .by{display:block;font-size:var(--type-small);line-height:var(--leading-small)}
.wt.src{background:var(--x-accent-soft);margin:0 calc(var(--space-2) * -1);padding:var(--space-2);border-radius:var(--radius-key);border-bottom-color:transparent}
.mk{border:1px solid var(--hairline-strong);border-radius:var(--radius-inset);background:var(--surface-pane);padding:var(--space-3) var(--space-4);display:flex;flex-direction:column;gap:var(--space-2)}
.mk .fm{display:grid;grid-template-columns:auto minmax(0,1fr);gap:var(--space-1) var(--space-3);font-size:var(--type-small);line-height:var(--leading-small)}
.mk .fm dt{color:var(--ink-muted)}
.mk .fm dd{margin:0;color:var(--ink)}
.mk .fm dd .from{color:var(--ink-muted)}
.mk .fm dd .in{color:var(--light);border-bottom:1px solid var(--x-accent-edge)}
.mk .det{display:flex;flex-direction:column;gap:2px}
.mk .det span{display:flex;justify-content:space-between;gap:var(--space-2)}
.mk .det i{font-style:normal;color:var(--ink-muted)}
.mk .det .exp::before{content:"";display:inline-block;width:2px;height:var(--space-3);background:var(--ink);margin-right:var(--space-2);vertical-align:-1px}
.mk .det .can::before{content:"";display:inline-block;width:2px;margin-right:var(--space-2)}
.mk .acts{display:flex;gap:var(--space-2);align-items:center;flex-wrap:wrap}
.mk .acts .m{font-size:var(--type-small);line-height:var(--leading-small);color:var(--ink-muted)}
.mk.done{border-color:var(--x-accent-edge)}
@media (max-width:1400px){:root{--x-side:calc(var(--measure-card) - var(--space-4))}.sent{font-size:var(--type-heading);line-height:calc(var(--leading-heading) + var(--space-4))}.tbl{grid-template-columns:calc(var(--space-7) + var(--space-3)) repeat(5,minmax(0,1fr))}.tile .gath span:nth-child(n+3){display:none}}
@media (max-width:1400px){.tile .t svg{display:none}}
@media (max-height:840px){.drawer .lede{display:none}.wt{padding:var(--space-1) 0;font-size:var(--type-small);line-height:var(--leading-small)}.fm .opt{display:none}.left{gap:var(--space-3)}.res .rec > .k,.res .rec > .v{padding:var(--space-1) 0}}
/*@html*/
<section class="op" id="op">
  <div class="left" id="left">
    <div class="said" id="said"></div>
    <div class="sent" id="sent" aria-live="polite"></div>
    <div id="ask"></div>
  </div>
  <aside class="right" id="right" aria-live="polite"></aside>
</section>
<section class="adm" id="adm" hidden>
  <div id="tblwrap" style="min-width:0;overflow:auto;scrollbar-width:thin"></div>
  <aside class="drawer" id="drawer" aria-live="polite"></aside>
</section>
/*@js*/
const S = { mode: 'fits', view: 'op', ans: [], result: undefined, sel: 'route', made: false };
const T = () => DATA.things[S.mode];
const val = (k, q) => (DATA.traits[k] || {})[q];
const answered = q => { const a = S.ans.find(x => x[0] === q); return a ? a[1] : undefined; };
/* a kind stays possible while no answer contradicts its traits ("not sure" contradicts nothing) */
const fitsAns = tr => S.ans.every(([q, a]) => a === null || tr[q] === undefined || tr[q] === a);
const left = () => DATA.kinds.filter(k => fitsAns(DATA.traits[k.id] || {}));
const ruledBy = tr => { const i = S.ans.findIndex(([q, a]) => a !== null && tr[q] !== undefined && tr[q] !== a); return i < 0 ? null : i; };
const predLeft = () => DATA.predicted.filter(p => p.traits && fitsAns(p.traits) && S.ans.length >= 3);
const accent = v => document.documentElement.style.setProperty('--x-accent', v === 'admin' ? 'var(--floor-org-high)' : 'var(--floor-team-high)');

function rail() {
  const op = S.view === 'op', p = op ? DATA.people.operator : DATA.people.admin;
  const nav = op
    ? [['Things we keep', 'boxes', 4597], ['Kinds of thing', 'shapes', 7], ['Add a thing', 'message-square-plus', null, 1], ['Triage', 'inbox', 7]]
    : [['Kinds of thing', 'shapes', 7, 1], ['Waiting for a kind', 'hourglass', 7], ['Kinds of link', 'waypoints', 12], ['Changes', 'history', 41]];
  $('#rail').innerHTML = `<div class="an">${DATA.app}${op ? '' : ' · Studio'}</div>
    <div class="who-am" data-tier="${FL(p.floor).tier}"><span class="dot"></span><span><b>${p.name}</b><br>${p.role}${p.tech ? tk(p.tech) : ''}<br>${FL(p.floor).kind} · ${FL(p.floor).name}</span></div>
    ${nav.map(([l, i, n, on]) => `<div class="nav${on ? ' on' : ''}">${ic(i)}<span>${l}</span>${n != null ? `<span class="n">${fmt(n)}</span>` : ''}</div>`).join('')}
    <div class="foot" id="railfoot"></div>`;
  techFoot();
}
function head() {
  const op = S.view === 'op';
  $('#crumb').textContent = op ? `${DATA.floors.team.name} · ${DATA.app} · Add a thing` : `${DATA.app} · Studio · Kinds of thing`;
  $('#h1').textContent = op ? 'Add a thing' : 'What waits for a kind';
  $('#sub').innerHTML = op
    ? `Answer a few questions; your answers fill in the sentence <i>it’s a ___ that ___</i>, and the sentence names its kind. Things we already keep that sound the same appear as it fills. <b>Nothing skips Triage.</b>`
    : `The table of kinds, families across and floors down. Its dotted slots are kinds it predicts; things nobody could place <b>wait on the slot their answers point to</b>, with how often each was asked for.`;
  $('#headR').innerHTML = `<div class="viewers" role="group" aria-label="Who is looking">
    <button data-v="op" class="${op ? 'on' : ''}" data-tier="team"><span class="dot"></span>${DATA.people.operator.name}, operator <span class="kbd">O</span></button>
    <button data-v="admin" class="${op ? '' : 'on'}" data-tier="org"><span class="dot"></span>${DATA.people.admin.name}, admin <span class="kbd">A</span></button></div>`;
}

/* ---------------- operator ---------------- */
function drawSaid() {
  const t = T();
  $('#said').innerHTML = `<span class="micro">In your words</span><span class="w">${t.said}</span><span class="n">${t.note}</span><span class="n">${ic('pencil-line')}${t.from}</span>`;
  Icons.hydrate($('#said'));
}
function family() {
  const L = left(); const fams = [...new Set(L.map(k => k.family))];
  if (fams.length === 1) return fams[0];
  if (!L.length) { const p = predLeft()[0] || DATA.predicted.find(x => x.id === T().slot); return answered('touch') === 1 && answered('stays') === 1 ? 'place' : p ? p.family : null; }
  return null;
}
function drawSent(fresh) {
  const t = T(), fam = family(), L = left(), done = S.result !== undefined;
  let diff = '', cls = '';
  if (L.length === 1 && done) { diff = L[0].diff; cls = ' set'; }
  else if (!L.length) {
    const p = S.ans.some(([q]) => q === 'line') && predLeft()[0];
    if (p) { diff = `${p.diff}`; cls = S.made && S.sel === p.id ? ' set' : ' wait'; } else { diff = 'no kind we keep fits'; cls = ' wait'; }
  }
  const lab = (w, t2) => `<span class="lab">${w}${tk(t2)}</span>`;
  let h = `<span class="subj">${t.said}</span> is <span class="slot${fam ? ' set' : ''}${fresh === 0 ? ' fresh' : ''}">${lab('what it is', W('family')[1])}${fam ? F(fam).a : '&nbsp;'}</span> that <span class="slot${cls}${fresh === 1 ? ' fresh' : ''}">${lab(cls === ' wait' ? 'no kind yet' : 'what sets it apart', 'differentia')}${diff || '&nbsp;'}</span>`;
  if (done && S.result) h += t.links.slice(0, 1).map(l => `, and <span class="slot set">${lab('link', W('link')[1])}${l[0]} ${l[1]}</span>`).join('');
  $('#sent').innerHTML = h;
  $('#sent').classList.toggle('done', done);
  if (fresh != null) later(() => $$('#sent .fresh').forEach(s => s.classList.remove('fresh')), ms('--motion-hold') / 4);
}
function nextQ() {
  const L = left(), asked = S.ans.map(a => a[0]);
  if (L.length === 1) { const tr = DATA.traits[L[0].id] || {}; const q = Object.keys(tr).find(q => tr[q] === 1 && !asked.includes(q)); return q ? Q(q) : null; }
  if (!L.length) { const p = DATA.predicted.filter(p => p.traits && fitsAns(p.traits)); const q = p.length && Object.keys(p[0].traits).find(q => !asked.includes(q)); return q ? Q(q) : null; }
  /* the question that best halves what's left */
  let best = null, bs = -1;
  for (const q of DATA.questions) { if (asked.includes(q.id)) continue;
    const y = L.filter(k => val(k.id, q.id) === 1).length, n = L.filter(k => val(k.id, q.id) === 0).length;
    const s = Math.min(y, n) + (y + n ? .1 : 0); if (y + n && s > bs) { bs = s; best = q; } }
  if (!best && L.length > 1) best = DATA.questions.find(q => !asked.includes(q.id) && L.some(k => val(k.id, q.id) === 1));
  return best || DATA.questions.find(q => !asked.includes(q.id));
}
function splitText(q) {
  const L = left();
  if (!L.length) { const p = DATA.predicted.find(p => p.traits && fitsAns(p.traits)); return `None of the ${DATA.kinds.length} kinds we keep fits your answers. If yes, it points to <b>${p.word}</b>, a kind the table predicts but nobody keeps yet.`; }
  const y = L.filter(k => val(k.id, q.id) === 1), n = L.filter(k => val(k.id, q.id) === 0);
  if (L.length === 1) return `One kind is left, ${L[0].plural}. This checks it: a no means nothing we keep fits.`;
  const name = a => a.map(k => k.plural).join(', ');
  return `It splits the ${L.length} left: yes leaves ${y.length ? name(y) : 'none we keep'}; no leaves ${n.length ? name(n) : 'none we keep'}.`;
}
function drawAsk() {
  const el = $('#ask'), q = nextQ(), L = left();
  const trail = S.ans.length ? `<div class="trail" aria-label="Your answers">${S.ans.map(([q, a], i) => `<span>${i + 1} · ${Q(q).q.replace(/\?$/, '')}? <b>${a === 1 ? 'Yes' : a === 0 ? 'No' : 'Not sure'}</b></span>`).join('')}</div>` : '';
  const poss = `<div><div class="micro" style="margin-bottom:var(--space-1)">Still possible ${tk('candidate classes')}</div><div class="poss">${DATA.kinds.map(k => { const r = ruledBy(DATA.traits[k.id] || {});
      return `<span class="pk${r != null ? ' out' : ''}${L.length === 1 && L[0] === k ? ' left1' : ''}"><span class="kind">${ic(k.icon)}${k.word}</span><span class="r">${r != null ? `ruled out by answer ${r + 1}` : 'still possible'}</span></span>`; }).join('')}
      ${!L.length ? DATA.predicted.filter(p => p.traits && fitsAns(p.traits)).map(p => `<span class="pk pred${S.ans.some(a => a[0] === 'line') ? ' hit' : ''}"><span>${p.word}</span><span class="r">predicted · nobody keeps it yet</span></span>`).join('') : ''}</div></div>`;
  if (S.result !== undefined) return;
  el.innerHTML = q ? `<div style="display:flex;flex-direction:column;gap:var(--space-3)"><div class="qbox"><div class="micro">Question ${S.ans.length + 1} · ${L.length || 'no'} kind${L.length === 1 ? '' : 's'} still possible</div>
      <div class="q">${q.q}</div><div class="split">${splitText(q)}</div>
      <div class="acts"><button class="btn go" data-a="1">Yes <span class="kbd">Y</span></button><button class="btn" data-a="0">No <span class="kbd">N</span></button><button class="btn quiet" data-a="null">Not sure <span class="kbd">U</span></button></div></div>${trail}${poss}</div>` : `${trail}${poss}`;
  Icons.hydrate(el);
}
function nearSentence(n) { const k = K(n.kind); return `<span class="nm">${n.name}</span> is ${F(k.family).a} that <span class="fit">${k.diff}</span>.`; }
function drawNear() {
  const list = DATA.near[S.mode], t = T();
  const outOf = n => n.out && answered(n.out[0]) === n.out[1];
  const live = list.filter(n => !outOf(n)).length;
  const head = S.mode === 'fits' || live ? 'Is it one of these?' : 'Closest we already keep';
  const why = S.ans.length === 0 ? `Found by name before any answer. ${DATA.matching}` : `${list.length} found by name; ${live} still fit${live === 1 ? 's' : ''} your answers. ${DATA.matching}`;
  const decide = S.result !== undefined && S.result && !S.decided;
  $('#right').innerHTML = `<h3>${head}${tk(W('near')[1])}</h3><p class="why">${why}</p>
    ${list.map(n => { const o = outOf(n), i = o ? S.ans.findIndex(a => a[0] === n.out[0]) : -1;
      return `<div class="ss${n.dup && !o ? ' dup' : ''}${o ? ' out' : ''}">${n.dup && !o ? `<div class="badge">${ic('copy', 12)}Likely the same thing · waiting in Triage</div>` : ''}
        ${nearSentence(n)}
        <span class="meta">${o ? `<span class="why-out">Not yours: it ${n.diff}; your answer ${i + 1} says otherwise.</span>` : `${n.same.map(s => `<span class="y">${ic('check', 12)}${s}</span>`).join('<br>')}<br>${ic('x', 12)}${n.diff}`}</span>
        <span class="meta">${n.where}</span>
        ${n.dup && decide && !o ? `<div class="acts"><button class="btn sm" data-same>Same thing: add to it</button><button class="btn sm go" data-new>Different: it’s new <span class="kbd">Enter</span></button></div>` : ''}</div>`; }).join('')}`;
  Icons.hydrate($('#right'));
}
function answer(a) {
  if (S.view !== 'op' || S.result !== undefined) return;
  const q = nextQ(); if (!q) return;
  S.ans.push([q.id, a]);
  const L = left(), famNow = family();
  const nq = nextQ();
  if (L.length === 1 && !nq) S.result = L[0].id;
  if (!L.length && !nq) S.result = null;
  drawSent(famNow && S.ans.length && !S.famShown ? 0 : (L.length <= 1 ? 1 : null)); if (famNow) S.famShown = true;
  drawAsk(); drawNear();
  if (S.result === null) later(waitSlip, ms('--motion-calm'));
  if (S.result) later(() => { drawSent(); drawNear(); $('#ask').innerHTML = `<p class="muted" style="font-size:var(--type-meta);margin:0">Your answers name it <b>${K(S.result).word}</b>. One thing we keep sounds very like it: is it the same?</p>`; }, ms('--motion-slow'));
}
function landRecord(same) {
  if (!S.result || S.decided) return; S.decided = true;
  const t = T(), k = K(S.result), dup = DATA.near.fits.find(n => n.dup), st = DATA.people.steward;
  drawNear();
  $('#said').style.display = 'none';
  if (same) {
    $('#ask').innerHTML = `<div class="res"><span class="stamp">${ic('inbox', 12)}Sent to Triage, as an addition</span><h3>Add to ${dup.name}</h3>
      <p>What you know is proposed as details of the thing already waiting. Where you differ (${dup.diff}), both show side by side until <b>${st.name}</b> decides.</p></div>`;
  } else {
    $('#ask').innerHTML = `<div class="res"><div class="row"><span class="stamp">${ic('inbox', 12)}A new ${k.word} · in Triage${tk('proposal · rdf:type ' + k.tech)}</span><span class="micro">every detail it could hold</span></div>
      <div class="rec">${t.record.map(r => `<div class="k">${r.d}</div><div class="v">${r.v ? `<span class="${r.link ? 'lk' : ''}">${r.v}</span><span class="src in">from ${r.src}</span>` : r.gap ? E.gap(r.gap) : r.none ? E.none(...r.none) : E.na(r.na)}</div>`).join('')}</div>
      <div class="whoL">${ic('user-round-check')}<span><b>${st.name}</b>, ${st.role} (${FL(st.floor).name}), checks it before it’s kept. You can use it now; it shows as “in Triage” until then.</span>
      ${ic('copy')}<span>You said it’s different from <b>${dup.name}</b>. ${st.name.split(' ')[0]} still sees both side by side, because the tags are one character apart.</span></div>
</div>`;
  }
  if (!same) { $('#right').insertAdjacentHTML('beforeend', `<div style="margin-top:var(--space-3)">${emptyKey(['gap', 'none', 'na'], true)}</div>`); }
  Icons.hydrate($('#ask')); reveal($('#ask').firstElementChild);
}
function waitSlip() {
  const t = T(), p = P(t.slot), a = DATA.people.admin, others = p.waiting.filter(w => w.name !== t.said);
  $('#said').style.display = 'none';
  if (S.made && S.sel === t.slot) {
    drawSent();
    $('#ask').innerHTML = `<div class="res"><span class="stamp">${ic('check', 12)}Placed · a ${p.word}, in Triage</span><p><b>${a.name}</b> made the kind <b>${p.word}</b> from your sentence. ${t.said} is now a ${p.word} record: everything you said came with it, and <b>Length</b> shows as Not known yet, which ${DATA.floors.team.name} could fill.</p>
      <p class="m">Your answers are kept with the record, so anyone can see why it was placed there.</p></div>`;
    Icons.hydrate($('#ask')); reveal($('#ask').firstElementChild); return;
  }
  $('#ask').innerHTML = `<div class="res waiting"><div class="row"><span class="stamp">${ic('hourglass', 12)}${W('waiting')[0]}${tk(W('waiting')[1])}</span><span class="micro">nothing is lost</span></div>
    <p>No kind we keep fits it yet, so it isn’t placed. It waits in Triage, on the slot your answers point to: <b>${p.word}</b>, a kind the table predicts but nobody keeps yet.</p>
    <div class="two"><div class="whoL">${ic('user-round-check')}<span><b>${a.name}</b>, who ${a.role} (${FL(a.floor).kind}), decides. ${tk(a.tech)}</span>
      ${ic('users')}<span>Asked for ${p.asks} times; ${others.length} other things wait there too (${others.map(o => o.name).join(', ')}).</span></div>
    <dl class="kept"><dt>Kept</dt><dd>Your sentence, your ${S.ans.length} answers, the note, where it came from</dd><dt>Links</dt><dd>${t.links.map(l => `${l[0]} ${l[1]}`).join('; ')}: proposed, kept with it</dd>
      <dt>Still works</dt><dd>Find it by name; attach the documents it came from</dd><dt>Not yet</dt><dd>Linking other things to it; it shows in no kind’s list</dd></dl></div>
    <p class="m">Closest kind: ${K(t.closest).word}. Putting it there would leave Address as a gap nobody can ever fill, so it isn’t offered as the answer.</p>
    <div style="display:flex;gap:var(--space-2);flex-wrap:wrap"><button class="btn sm" aria-disabled="true" title="Possible, but ${DATA.people.steward.name} would see you weren’t sure">Put it under ${K(t.closest).word} anyway</button><button class="btn sm go" data-v="admin">See it as ${a.name} does <span class="kbd">A</span></button></div></div>`;
  Icons.hydrate($('#ask')); reveal($('#ask').firstElementChild);
}

/* ---------------- admin ---------------- */
function drawTable() {
  const rows = DATA.rows, made = S.made;
  const kTile = k => `<div class="tile" data-tier="${FL(k.floor).tier}" style="box-shadow:inset 2px 0 0 var(--fc)"><div class="t">${ic(k.icon)}<span>${k.plural}</span></div>
      <span class="c" title="${fmt(k.n)} kept, ${k.known}% of their details known">${fmt(k.n)} · ${k.known}%</span><div class="bar" aria-hidden="true"><i style="flex-grow:${k.known}"></i><i style="flex-grow:${100 - k.known};background:transparent"></i></div>${tk(k.tech)}</div>`;
  const pTile = p => { const m = made && p.id === S.sel;
    if (m) return `<div class="tile made" data-tier="department" style="box-shadow:inset 2px 0 0 var(--fc)"><div class="t">${ic('route')}<span>${p.word}</span></div><span class="c">${p.waiting.length} · 41% known</span>
      <div class="bar"><i style="flex-grow:41"></i><i style="flex-grow:59;background:transparent"></i></div><div class="gath">${p.waiting.map(w => `<span>${w.name}</span>`).join('')}</div></div>`;
    return `<button class="tile pred${p.waiting.length ? '' : ' empty'}${S.sel === p.id ? ' sel' : ''}" data-slot="${p.id}"><div class="t"><span>${p.word}</span></div>
      <span class="c">${p.waiting.length ? `${p.waiting.length} waiting · ${p.asks} ask${p.asks === 1 ? '' : 's'}` : 'nobody has asked'}</span>
      ${p.waiting.length ? `<div class="gath">${p.waiting.map(w => `<span title="${w.name}">${w.name}</span>`).join('')}</div>` : ''}${tk('empty class slot')}</button>`; };
  let h = `<div class="tbl"><div></div>${DATA.families.map(f => `<div class="fh">${f.word}${tk(f.tech)}</div>`).join('')}`;
  for (const r of rows) {
    const f = FL(r), ks = DATA.kinds.filter(k => k.floor === r);
    h += `<div class="rh" data-tier="${f.tier}"><b>${f.name}</b><span>${f.kind}</span></div>`;
    if (!ks.length && DATA.rowNote[r]) { h += `<div class="note">${DATA.rowNote[r]}</div>`; continue; }
    h += DATA.families.map(fm => `<div class="cell">${ks.filter(k => k.family === fm.id).map(kTile).join('')}</div>`).join('');
  }
  h += `<div class="rh pr"><b>Not kept yet</b><span>predicted slots</span></div>`;
  h += DATA.families.map(fm => `<div class="cell">${DATA.predicted.filter(p => p.family === fm.id).map(pTile).join('')}</div>`).join('');
  const ns = DATA.noSlot[0], hf = FL(DATA.hiddenWaiting.floor);
  h += `<div class="rh pr" style="border-right-color:transparent"><b>Waiting elsewhere</b></div><div class="margin">
    <div class="tile"><div class="t"><span>${ns.name}</span></div><span class="w">Fits no slot the table predicts. ${ns.by}, ${FL(ns.floor).name}, ${ns.on}: “it ${ns.said}”. Draw a slot for it, or answer ${ns.by.split(' ')[0]}.</span></div>
    <div class="tile">${E.unseen(DATA.hiddenWaiting.floor, `some things wait in ${hf.name}’s own Triage`)}<span class="w">Shown as “some”, never a number, so the count doesn’t leak. Exact counts here are a decision for Harry.</span></div></div></div>`;
  $('#tblwrap').innerHTML = h; Icons.hydrate($('#tblwrap'));
  $('#adm').classList.toggle('focus', !!S.sel);
}
function drawDrawer() {
  const p = P(S.sel), a = DATA.people.admin, src = p.waiting.find(w => w.name === DATA.things.misfit.said) || p.waiting[0];
  const fam = F(p.family);
  if (!p.waiting.length) { $('#drawer').innerHTML = `<div class="micro">Predicted slot · ${fam.word}</div><h2>${p.word}</h2><p class="lede">A thing that ${p.diff}. Nobody has asked for it and nothing waits here. It stays on the table so the next person who needs it sees it’s foreseen.</p>`; return; }
  const waitHTML = `<div>${p.waiting.map(w => `<div class="wt${w === src ? ' src' : ''}"><span class="nm">${w.name}</span> is ${fam.a} that ${w.said}.<span class="by">${w.by} · ${FL(w.floor).name} · ${w.on}</span></div>`).join('')}</div>`;
  if (S.made) {
    const r = DATA.things.misfit, op = DATA.people.operator;
    $('#drawer').innerHTML = `<div class="micro">Kind of thing · ${fam.word} · ${FL('dept').name}${tk('class · rdfs:subClassOf ' + fam.tech)}</div><h2>${p.word}</h2>
      <p class="lede">Made from ${src.by.split(' ')[0]}’s sentence. The ${p.waiting.length} things that waited are now ${p.word} records, each with its gaps marked, still checked in Triage. ${op.name}, ${p.waiting.filter(w => w.by !== op.name && w.by.includes(' ')).map(w => w.by).join(' and ')} are told.</p>
      <div class="mk done"><span class="stamp">${ic('check', 12)}${r.said} · placed</span>
        <div class="rec" style="font-size:var(--type-small)"><div class="k">Looked after by</div><div class="v"><span class="lk">${DATA.floors.team.name}</span></div>
        <div class="k">From and to</div><div class="v">Ollerton, Blyth</div>
        <div class="k">Length</div><div class="v">${E.gap(DATA.floors.team.name)}</div>
        <div class="k">Worked on under</div><div class="v"><span class="lk">Resurfacing 2026/09</span></div></div>
</div>${emptyKey(['gap'], true)}`;
    Icons.hydrate($('#drawer')); return;
  }
  $('#drawer').innerHTML = `<div class="micro">Predicted slot · ${fam.word} · ${p.asks} asks${tk(W('predicted')[1])}</div><h2>${p.word}</h2>
    <p class="lede">${p.waiting.length} things wait here, placed by their answers. Each kept everything its person said.</p>${waitHTML}
    <div class="mk"><div class="micro">Make it a kind, from ${src.by.split(' ')[0]}’s sentence</div>
      <dl class="fm"><dt>Called</dt><dd><span class="in">${p.word}</span> <span class="from">· the slot’s name; rename freely</span>${tk('rdfs:label · vrs:RouteOrArea')}</dd>
        <dt>What it is</dt><dd><span class="in">${fam.a}</span> <span class="from">· from “is ${fam.a}”</span>${tk('rdfs:subClassOf ' + fam.tech)}</dd>
        <dt>Sets it apart</dt><dd><span class="in">${p.diff}</span> <span class="from">· from “${src.said}”</span>${tk('skos:definition')}</dd>
        <dt class="opt">Its question</dt><dd class="opt">${Q('line').q} <span class="from">· already asked, so placing finds it</span></dd>
        <dt>Details</dt><dd><div class="det">${p.details.map(([d, t, n], i) => `<span><span class="${i ? 'can' : 'exp'}">${d}</span><i>${t} · ${n} said it</i></span>`).join('')}</div>${tk('first is sh:minCount 1; the rest optional')}</dd>
        <dt>Kept on</dt><dd>${flChip('dept')} <span class="from">· most asks came from there</span></dd></dl>
      <div class="acts"><button class="btn go" data-make>Make the kind <span class="kbd">Enter</span></button><span class="m">Places the ${p.waiting.length} waiting things as records, with gaps marked. Each is still checked in Triage.</span></div></div>`;
  Icons.hydrate($('#drawer'));
}
function make() { if (S.view !== 'admin' || S.made || !P(S.sel).waiting.length) return; S.made = true; drawTable(); drawDrawer(); reveal($('#drawer').firstElementChild); }

/* ---------------- views and demo ---------------- */
function setView(v) {
  S.view = v; accent(v); rail(); head();
  $('#op').hidden = v !== 'op'; $('#adm').hidden = v !== 'admin';
  if (v === 'admin') { drawTable(); drawDrawer(); reveal($('#adm')); }
  keys(v === 'op'
    ? [['Y', 'yes'], ['N', 'no'], ['U', 'not sure'], ['Enter', 'it’s new'], ['1', 'a thing that fits'], ['2', 'one that fits nothing'], ['A', 'admin'], ['T', 'technical words'], ['R', 'replay']]
    : [['←→', 'slot'], ['Enter', 'make the kind'], ['O', 'operator'], ['T', 'technical words'], ['R', 'replay']]);
}
function startOp(mode) {
  clearLater(); S.mode = mode; S.ans = []; S.result = undefined; S.decided = false; S.famShown = false;
  $('#said').style.display = ''; drawSaid(); drawSent(); drawAsk(); drawNear();
  const t = T(), g = ms('--motion-calm') + ms('--motion-base');
  t.answers.forEach(([q, a], i) => later(() => answer(a), ms('--motion-run') + g * i));
  if (mode === 'fits') later(() => landRecord(false), ms('--motion-run') + g * t.answers.length + ms('--motion-run'));
}
const V = {
  reset() {
    S.made = false; S.sel = 'route';
    const h = location.hash;
    if (h.includes('admin')) { S.mode = 'misfit'; setView('admin'); if (h.includes('made')) { S.made = true; drawTable(); drawDrawer(); } return; }
    setView('op'); S.mode = h.includes('misfit') ? 'misfit' : 'fits'; S.ans = []; S.result = undefined; S.decided = false;
    $('#said').style.display = ''; drawSaid(); drawSent(); drawAsk(); drawNear();
  },
  demo() { if (S.view === 'op') startOp(S.mode); },
  onTech() { if (S.view === 'admin') { drawTable(); drawDrawer(); } },
  key(e) {
    const k = e.key.toLowerCase();
    if (k === 'a') { setView('admin'); return true; }
    if (k === 'o') { setView('op'); if (!S.ans.length) startOp(S.mode); else if (S.result === null) waitSlip(); return true; }
    if (S.view === 'op') {
      if (k === '1') { setView('op'); startOp('fits'); return true; }
      if (k === '2') { setView('op'); startOp('misfit'); return true; }
      if (k === 'y') { if (S.result && !S.decided) landRecord(true); else { clearLater(); answer(1); } return true; }
      if (k === 'n') { clearLater(); answer(0); return true; }
      if (k === 'u') { clearLater(); answer(null); return true; }
      if (e.key === 'Enter' && S.result) { clearLater(); landRecord(false); return true; }
    } else {
      if (e.key === 'Enter') { make(); return true; }
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { const ids = DATA.predicted.map(p => p.id); let i = ids.indexOf(S.sel) + (e.key === 'ArrowRight' ? 1 : -1); S.sel = ids[(i + ids.length) % ids.length]; S.made = false; drawTable(); drawDrawer(); return true; }
    }
  }
};
document.addEventListener('click', e => {
  const a = e.target.closest('[data-a]'), v = e.target.closest('[data-v]'), s = e.target.closest('[data-slot]');
  if (a) { clearLater(); answer(a.dataset.a === 'null' ? null : +a.dataset.a); }
  if (v) { setView(v.dataset.v); if (v.dataset.v === 'op' && S.result === null) waitSlip(); }
  if (s) { S.sel = s.dataset.slot; S.made = false; drawTable(); drawDrawer(); }
  if (e.target.closest('[data-new]')) { clearLater(); landRecord(false); }
  if (e.target.closest('[data-same]')) { clearLater(); landRecord(true); }
  if (e.target.closest('[data-make]')) make();
});
boot(V);
