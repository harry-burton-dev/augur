{
  "name": "@augur/shell",
  "version": "0.16.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The shell host: wraps ui-shell, loads apps from the registry manifest, mounts the current app and routes intents.",
  "scripts": {
    "dev": "vite build -c vite.shared.config.ts --mode development && vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build -c vite.shared.config.ts && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "build:shared": "vite build -c vite.shared.config.ts"
  },
  "dependencies": {
    "@augur/app-kit": "npm:@harry-burton-dev/augur-app-kit@^0.7.0",
    "@augur/kit-common": "npm:@harry-burton-dev/augur-kit-common@^0.7.0",
    "@augur/mfe-sdk": "workspace:*",
    "@augur/shell-kit": "npm:@harry-burton-dev/augur-shell-kit@^0.6.0",
    "@augur/ui-kit": "workspace:*",
    "@grafana/faro-transport-otlp-http": "^2.13.0",
    "@grafana/faro-web-sdk": "^2.13.0",
    "@grafana/faro-web-tracing": "^2.13.0",
    "lit": "^3.3.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@augur/kit-bundle": "npm:@harry-burton-dev/augur-kit-bundle@0.5.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.0"
  }
}
