{
  "name": "@platform/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The shell host: wraps ui-shell, loads apps from the registry manifest, mounts the current app and routes intents.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@platform/mfe-sdk": "workspace:*",
    "@platform/ui-kit": "workspace:*",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.0"
  }
}
