{
  "name": "@augur/contract-tests",
  "version": "0.1.14",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The shell's promise to apps, tested: a reference app, and frozen builds of it from each SDK release, mounted by the real shell in a browser.",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:contract": "node run.mjs",
    "freeze": "vite build && node freeze.mjs"
  },
  "dependencies": {
    "@augur/app-kit": "npm:@harry-burton-dev/augur-app-kit@^0.6.1",
    "@augur/mfe-sdk": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7"
  }
}
