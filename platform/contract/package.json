{
  "name": "@augur/contract-tests",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "description": "The shell's promise to apps, tested: a reference app, and frozen builds of it from each SDK release, mounted by the real shell in a browser.",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:contract": "node run.mjs",
    "freeze": "vite build && node freeze.mjs"
  },
  "dependencies": {
    "@augur/mfe-sdk": "workspace:*",
    "@augur/ui-kit": "workspace:*",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7"
  }
}
