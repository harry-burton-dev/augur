{
  "id": "reference",
  "name": "Reference",
  "route": "/reference",
  "entry": "/apps/reference/entry.js",
  "version": "0.0.0",
  "sdk": "^1.0.0",
  "description": "Uses every part of the mount context, for the contract tests",
  "icon": "apps",
  "handles": ["reference.show", "reference.answer"],
  "search": true,
  "intents": [
    {
      "type": "reference.show",
      "description": "Show something in the Reference app",
      "payload": { "type": "object", "properties": { "what": { "type": "string" } } },
      "confirm": "Show “{what}”"
    }
  ],
  "surfaces": [{ "floor": "personal", "slot": "card", "module": "./Glance" }]
}
