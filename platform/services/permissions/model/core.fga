module core

# Who someone is comes from Keycloak (the token's `sub`). This model says what they may do.

type person

# A position, such as Harbour master or Head of operations (ADR 0089). Permissions given to a persona stay
# with it when its holder changes: whoever holds it now has them, through `persona#holder`, alongside their
# own, and the next holder has them at once. Floors are joined by positions, not people. A persona that holds
# deployment or org admin is the one exception: those go to the persona itself, so using them needs a
# persona session (step-up sign-in, time limit, reason, ADR 0086), and they never reach the person.
type persona
  relations
    define holder: [person]

# Meta-platform: the deployment itself (ADR 0084: removal, version pins, site allowing, app secrets).
type deployment
  relations
    define org: [org]
    define admin: [persona]
    define can_upgrade: admin
    define can_install_apps: admin
    define can_remove_apps: admin
    define can_pin_versions: admin
    define can_allow_sites: admin
    define can_set_app_secrets: admin
    define can_read_settings: admin
    define can_read_health: admin or admin from org

# The organisation: the top floor, and where org-wide roles live.
type org
  relations
    define child: [floor]
    define admin: [persona]
    define member: [person]
    define publisher: [person, persona#holder, role#assignee]
    define audit_reader: [person, persona, persona#holder, role#assignee]
    define manager: admin
    define stands: member or stands from child
    define can_see: stands or admin
    define can_manage_people: admin
    define can_manage_apps: admin
    define can_manage_org: admin
    define can_read_audit: admin or audit_reader
    define can_publish_to_org: publisher
    define can_create_role: admin

# A team or department floor, or someone's own floor. A person's own floor is the only one a person is on
# directly (as its owner); team and department floors are joined by positions (ADR 0089). Standing goes up:
# a member of a team stands on every floor above it. Managing goes down: a lead manages the floors below
# theirs. Leading does not.
type floor
  relations
    define parent: [floor, org]
    define child: [floor]
    define owner: [person]
    define lead: [persona#holder, role#assignee]
    define member: [persona#holder, role#assignee] or lead
    define blocked: [person]
    define admin: admin from parent
    define manager: lead or manager from parent
    define stands: (owner or member or stands from child) but not blocked
    define can_see: stands or admin
    define can_manage_members: manager or admin
    define can_act_as_lead: lead but not blocked
    define can_create_role: manager or admin
    # The knowledge graph's floor roles (ADR 0079, amended by 0095): who settles a floor's disputes and holds what
    # its people retained, and who raises its beliefs to the floor above. A position or a person, set in Admin's
    # settings for the floor; a position's next holder has it at once. Leading a floor doesn't give either.
    define settler: [person, persona#holder, role#assignee]
    define raiser: [person, persona#holder, role#assignee]
    define can_settle: settler but not blocked
    define can_raise: raiser but not blocked

# A role made inside AUGUR (by an admin, a lead, or an app) for one floor or the org. Roles hold people,
# positions (their holders, or an admin persona itself), other roles' holders, or a whole floor's members. A role is a set of holders; what it gives
# is written where it applies (OpenFGA's custom-roles pattern). A person or a position may be given a role until a
# time (ADR 0085, D7): the grant stops answering at that time, whatever the grants ledger's sweep has done.
type role
  relations
    define scope: [floor, org]
    define assignee: [person, person with not_expired, persona, persona#holder, persona#holder with not_expired, role#assignee, floor#member]
    define can_assign: manager from scope or admin from scope
    define can_grant_with: can_assign

# A grant that ends at a time (ADR 0085, D7). The service sends `current_time` with every check; apps' modules use it too.
condition not_expired(current_time: timestamp, grant_expires: timestamp) {
  current_time < grant_expires
}
