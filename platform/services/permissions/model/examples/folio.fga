module folio

# An app's own module: Artifacts (Folio) brings its document type and how it is shared.

type document
  relations
    define floor: [floor]
    define owner: [person]
    define editor: [person, person with not_expired, role#assignee] or owner or lead from floor
    define viewer: [person, person with not_expired, role#assignee] or editor or stands from floor
    define blocked: [person]
    define can_view: viewer but not blocked
    define can_edit: editor but not blocked
    define can_share: (owner or lead from floor) but not blocked

condition not_expired(current_time: timestamp, grant_expires: timestamp) {
  current_time < grant_expires
}
