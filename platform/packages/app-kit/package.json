{
  "name": "@augur/app-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quill: the React kit apps build with, on Common. Served to every app through the shell's import map, under the SDK promise.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css"
  },
  "files": [
    "dist",
    "theme.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@augur/kit-common": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
