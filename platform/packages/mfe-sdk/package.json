{
  "name": "@augur/mfe-sdk",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "description": "The contract between the shell and micro frontends: registration, mount context, event bus and intents.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "msw": "2.15.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "msw": "^2.0.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  }
}
