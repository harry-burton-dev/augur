{
  "name": "@augur/mfe-sdk",
  "version": "3.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The contract between the shell and micro frontends: registration, mount context, event bus and intents.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./sdk3": {
      "types": "./dist/sdk3/index.d.ts",
      "default": "./dist/sdk3/index.js"
    },
    "./sdk3/runtime": {
      "types": "./dist/sdk3/runtime.d.ts",
      "default": "./dist/sdk3/runtime.js"
    },
    "./sdk3/host": {
      "types": "./dist/sdk3/host.d.ts",
      "default": "./dist/sdk3/host.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@remote-dom/core": "1.12.1"
  },
  "devDependencies": {
    "msw": "2.15.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "msw": "^2.0.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  }
}
