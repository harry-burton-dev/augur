{
  "name": "@augur/service-kit",
  "version": "0.12.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "What a backend service needs to know who is calling: the caller the gateway verified, carried in request headers.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "^5.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "jose": "^6.2.12"
  }
}
