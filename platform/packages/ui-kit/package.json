{
  "name": "@augur/ui-kit",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "description": "Design tokens, base CSS and web components rebuilt from the Wave design system.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "node scripts/build-tokens.mjs && tsc -p tsconfig.json && cp src/base.css dist/base.css",
    "typecheck": "node scripts/build-tokens.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build-tokens.mjs && vitest run",
    "storybook": "node scripts/build-tokens.mjs && storybook dev -p 6006",
    "build-storybook": "node scripts/build-tokens.mjs && storybook build -o storybook-static"
  },
  "dependencies": {
    "@fontsource/jost": "5.2.8",
    "@fontsource/nunito": "5.2.7",
    "lit": "^3.3.0",
    "lucide": "^1.59.0",
    "markdown-it": "^14.3.3"
  },
  "devDependencies": {
    "@storybook/web-components-vite": "10.6.2",
    "@types/markdown-it": "^14.2.0",
    "happy-dom": "^20.0.0",
    "storybook": "10.6.2",
    "style-dictionary": "5.7.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.0"
  }
}
