{
  "$schema": "urn:augur:app-manifest:3",
  "id": "notes",
  "name": "Notes",
  "version": "1.0.0",
  "contract": 3,
  "description": "Short notes kept per floor",
  "icon": "notebook",
  "floors": [
    "personal",
    "team",
    "org"
  ],
  "frontend": {
    "entry": "https://cdn.example.com/notes/entry.js"
  },
  "api": {
    "openapi": "service/openapi.json"
  },
  "scopes": [
    "notifications:send",
    "events:publish",
    "events:subscribe",
    "people:read"
  ],
  "maxUpload": 25,
  "contributes": {
    "places": [
      {
        "id": "recent",
        "label": "Recent",
        "icon": "clock",
        "path": "/"
      },
      {
        "id": "notebooks",
        "label": "Notebooks",
        "icon": "book",
        "fills": true,
        "detail": "One per topic"
      },
      {
        "id": "archive",
        "label": "Archive",
        "icon": "archive",
        "role": "lead"
      }
    ],
    "commands": [
      {
        "id": "note.new",
        "label": "New note",
        "icon": "plus",
        "keywords": "create write",
        "when": "always"
      },
      {
        "id": "note.archive",
        "label": "Archive note",
        "icon": "archive",
        "when": "selection"
      },
      {
        "id": "note.share",
        "label": "Share note",
        "icon": "share",
        "when": "selection"
      }
    ],
    "radial": [
      {
        "command": "note.share",
        "on": "note",
        "order": 0
      },
      {
        "command": "note.archive",
        "on": "note",
        "order": 1
      }
    ],
    "about": [
      {
        "id": "details",
        "label": "Details",
        "icon": "info"
      },
      {
        "id": "history",
        "label": "History",
        "icon": "clock"
      }
    ],
    "settings": [
      {
        "id": "retentionDays",
        "label": "Keep archived notes for",
        "type": "number",
        "unit": "days",
        "min": 7,
        "max": 3650,
        "default": 365
      },
      {
        "id": "allowSharing",
        "label": "Notes can be shared outside the floor",
        "type": "boolean",
        "default": false
      },
      {
        "id": "defaultNotebook",
        "label": "Default notebook name",
        "type": "string",
        "default": "General"
      },
      {
        "id": "theme",
        "label": "Note colour",
        "type": "enum",
        "options": [
          "plain",
          "warm",
          "cool"
        ],
        "default": "plain"
      },
      {
        "id": "exportKey",
        "label": "Export service key",
        "type": "secret",
        "detail": "The key used when notes are exported to the archive service",
        "required": false
      }
    ],
    "intents": {
      "handles": [
        "note.open",
        "note.pick"
      ]
    },
    "notifications": {
      "kinds": [
        {
          "id": "shared",
          "label": "Notes shared with you",
          "detail": "When someone shares a note with you"
        }
      ]
    },
    "search": true
  },
  "previews": [
    {
      "id": "board-view",
      "name": "Board view",
      "detail": "Notes as cards on a board"
    }
  ]
}