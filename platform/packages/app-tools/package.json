{
  "name": "@augur/app-tools",
  "version": "0.6.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The release steps every AUGUR app shares: dev builds, previews, signed bundles and the app-release.json a deployment installs from, as the augur-app command for an app in its own repository.",
  "exports": {
    ".": {
      "types": "./src/release.d.ts",
      "default": "./src/release.mjs"
    },
    "./release2": {
      "types": "./src/release2.d.ts",
      "default": "./src/release2.mjs"
    },
    "./validate": {
      "types": "./src/validate.d.ts",
      "default": "./src/validate.mjs"
    },
    "./manifest.schema.json": "./manifest.schema.json",
    "./manifest-3.schema.json": "./manifest-3.schema.json",
    "./score-part-1.schema.json": "./score-part-1.schema.json",
    "./app-release-2.schema.json": "./app-release-2.schema.json",
    "./score-v1b1.json": "./score-v1b1.json",
    "./catalog": {
      "types": "./src/catalog.d.ts",
      "default": "./src/catalog.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "augur-app": "./bin/augur-app.mjs"
  },
  "files": [
    "src/release.mjs",
    "src/release2.mjs",
    "src/validate.mjs",
    "src/catalog.mjs",
    "bin",
    "manifest.schema.json",
    "manifest-3.schema.json",
    "score-part-1.schema.json",
    "app-release-2.schema.json",
    "score-v1b1.json",
    "fixtures",
    "src/release2.d.ts",
    "src/validate.d.ts",
    "src/release.d.ts",
    "src/catalog.d.ts"
  ],
  "scripts": {
    "test": "node --test src/*.test.mjs"
  },
  "dependencies": {
    "@augur/service-kit": "workspace:*",
    "semver": "catalog:",
    "typebox": "catalog:",
    "yaml": "catalog:"
  }
}
