# AUGUR's UI kit comes from GitHub Packages (ADR 0046), published as @harry-burton-dev/augur-<name> and
# aliased back to @augur/<name> in package.json. CI sets NODE_AUTH_TOKEN; on a laptop or a server
# building from source, set it to a GitHub token with read:packages.
@harry-burton-dev:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
