{
  "about": "Review tiers by path (REVIEW.md). A pull request is High if any path matches high (and not notHigh), Low if every path matches low (and not notLow), otherwise Medium. harryOk: the High paths that also wait for Harry's ok. deployTest: the paths whose change runs on a server, which get the deploy test before merging. Globs follow node:path matchesGlob. A bot's pull request (Renovate) has no description to check: it needs only Harry's ok on his paths.",
  "high": [
    "platform/services/updater/**",
    "platform/services/identity/**",
    "platform/services/permissions/**",
    "platform/services/gateway/**",
    "platform/services/events/**",
    "platform/services/registry/**",
    "platform/services/*/src/store.ts",
    "platform/services/*/src/migrat*",
    "platform/services/*/src/migrations/**",
    "platform/packages/service-kit/**",
    "platform/packages/mfe-sdk/src/**",
    "platform/packages/mfe-sdk/etc/**",
    "platform/packages/app-tools/**",
    "platform/frontends/sign-in-theme/**",
    "infra/**",
    "release/**",
    ".github/**",
    "scripts/*release*",
    "scripts/promote*",
    "scripts/halt*",
    "scripts/publish-feed*",
    "scripts/mirror-release*",
    "scripts/pipeline*",
    "scripts/check-migrations*",
    "scripts/review-tier*",
    "docs/release-channels.md",
    "REVIEW.md",
    "platform/services/storage/**"
  ],
  "notHigh": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.mjs",
    "**/*.testing.ts",
    "**/README.md",
    "infra/docker-compose.yml"
  ],
  "low": [
    "**/*.md",
    ".changeset/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.mjs",
    "**/*.stories.tsx",
    "docs/src/content/**"
  ],
  "notLow": [
    "REVIEW.md",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/upgrade.md",
    "docs/release-channels.md",
    "docs/deploy*"
  ],
  "harryOk": [
    "platform/services/updater/**",
    "platform/services/identity/src/**",
    "platform/services/permissions/src/**",
    "infra/deploy/backup/**",
    "infra/deploy/postgres/**",
    "infra/release-*",
    "release/augur-release.json",
    "release/app-repos.json",
    ".github/workflows/**",
    "scripts/*release*",
    "scripts/promote*",
    "scripts/halt*",
    "scripts/publish-feed*",
    "scripts/mirror-release*",
    ".github/review-tiers.json",
    "REVIEW.md"
  ],
  "deployTest": [
    "infra/**",
    "release/**",
    "contracts/**",
    "platform/services/*/src/**",
    "platform/services/*/package.json",
    "platform/packages/*/src/**",
    "platform/packages/*/package.json",
    "platform/frontends/sign-in-theme/**",
    "package.json",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml"
  ]
}
