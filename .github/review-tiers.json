{
  "about": "Review tiers by path (REVIEW.md). A pull request is High if any path matches high (and not notHigh), Low if every path matches low (and not notLow), otherwise Medium. Generated files (notCount) don't count towards the tier, nor (ignoreRenames) do files only renamed. harryOk: the paths that wait for Harry's ok, kept to what can't be undone: migrations, backups and Postgres, Promote to stable and Halt. harryOkWhen: rules on what a change adds or takes away, for a workflow that gains privilege, a riskier trigger or a new action. autoOk: each High pull request that merges without his ok gets an auto-ok record. deployTest: the paths whose change runs on a server, which get the deploy test before merging. Globs follow node:path matchesGlob. A bot's pull request (Renovate) has no description to check: it needs only Harry's ok on his paths.",
  "high": [
    "platform/services/updater/**",
    "platform/services/identity/**",
    "platform/services/permissions/**",
    "platform/services/gateway/**",
    "platform/services/events/**",
    "platform/services/registry/**",
    "platform/services/*/src/store.ts",
    "platform/services/*/src/migrat*",
    "platform/services/*/src/migrations/**",
    "platform/packages/service-kit/**",
    "platform/packages/mfe-sdk/src/**",
    "platform/packages/mfe-sdk/etc/**",
    "platform/packages/app-tools/**",
    "platform/frontends/sign-in-theme/**",
    "infra/**",
    "release/**",
    ".github/**",
    "scripts/*release*",
    "scripts/promote*",
    "scripts/halt*",
    "scripts/publish-feed*",
    "scripts/mirror-release*",
    "scripts/pipeline*",
    "scripts/check-migrations*",
    "scripts/review-tier*",
    "REVIEW.md",
    "platform/services/storage/**"
  ],
  "notHigh": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.mjs",
    "**/*.testing.ts",
    "**/README.md",
    "infra/docker-compose.yml",
    "infra/deploy-test.sh",
    "infra/deploy-browser-check.mjs",
    ".github/pull_request_template.md"
  ],
  "low": [
    "**/*.md",
    ".changeset/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.mjs",
    "**/*.stories.tsx",
    "docs/src/content/**"
  ],
  "notLow": [
    "REVIEW.md",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/upgrade.md",
    "docs/release-channels.md",
    "docs/deploy*"
  ],
  "notCount": [
    "release/migrations.lock.json",
    "release/kit.json",
    "pnpm-lock.yaml"
  ],
  "ignoreRenames": true,
  "harryOk": [
    "platform/services/*/src/migrat*",
    "platform/services/*/src/migrations/**",
    "infra/deploy/backup/**",
    "infra/deploy/postgres/**",
    "scripts/promote*",
    "scripts/halt*",
    ".github/workflows/promote.yml",
    ".github/workflows/halt.yml"
  ],
  "harryOkWhen": [
    {
      "paths": [
        ".github/workflows/**",
        ".github/actions/**"
      ],
      "added": "^\\s*permissions:|: *write\\b|\\bsecrets\\b|id-token|pull_request_target|workflow_run|issue_comment|uses:\\s*['\"]?docker://",
      "why": "gives a workflow more privilege or a riskier trigger"
    },
    {
      "paths": [
        ".github/workflows/**",
        ".github/actions/**"
      ],
      "removed": "^\\s*permissions:|: *(read|none)\\b",
      "why": "takes a limit off a workflow's token"
    },
    {
      "paths": [
        ".github/workflows/**",
        ".github/actions/**"
      ],
      "newAction": true,
      "why": "uses an action no workflow used before"
    }
  ],
  "autoOk": true,
  "deployTest": [
    "infra/**",
    "release/**",
    "contracts/**",
    "platform/services/*/src/**",
    "platform/services/*/package.json",
    "platform/packages/*/src/**",
    "platform/packages/*/package.json",
    "platform/frontends/sign-in-theme/**",
    "package.json",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml"
  ]
}
