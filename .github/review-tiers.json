{
  "about": "Review tiers by path (REVIEW.md). A pull request is High if any path matches high (and not notHigh), Low if every path matches low (and not notLow), otherwise Medium. Generated files (notCount) don't count towards the tier, nor (ignoreRenames) do files only renamed. harryOk (named from when these waited for Harry): the paths that need a deep code review (/code-review at high effort or more), kept to what can't be undone or gives more access: migrations, backups and Postgres, Promote to stable and Halt, the updater's trusted signers, and the review check's own script, workflow and tiers. harryOkWhen: rules on what a change adds or takes away, for a new or changed migration (its lock entry) and a workflow that gains privilege, a riskier trigger or a new action. autoOk: each High pull request that merges gets an auto-ok record, which is how Harry hears of it. deployTest: the paths whose change runs on a server, which get the deploy test before merging, apart from notDeployTest (tests). Globs follow node:path matchesGlob. A bot's pull request (Renovate) has no description: on the deep-review paths an agent takes it over first.",
  "high": [
    "platform/services/updater/**",
    "platform/services/identity/**",
    "platform/services/permissions/**",
    "platform/services/gateway/**",
    "platform/services/events/**",
    "platform/services/registry/**",
    "platform/services/*/src/store.ts",
    "platform/services/*/src/migrat*",
    "platform/services/*/src/migrations/**",
    "platform/packages/service-kit/**",
    "platform/packages/mfe-sdk/src/**",
    "platform/packages/mfe-sdk/etc/**",
    "platform/packages/app-tools/**",
    "platform/frontends/sign-in-theme/**",
    "infra/**",
    "release/**",
    ".github/**",
    "scripts/*release*",
    "scripts/promote*",
    "scripts/halt*",
    "scripts/publish-feed*",
    "scripts/mirror-release*",
    "scripts/pipeline*",
    "scripts/check-migrations*",
    "scripts/review-tier*",
    "REVIEW.md",
    "platform/services/storage/**"
  ],
  "notHigh": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.mjs",
    "**/*.testing.ts",
    "**/README.md",
    "infra/docker-compose.yml",
    "infra/deploy-test.sh",
    "infra/deploy-browser-check.mjs",
    ".github/pull_request_template.md"
  ],
  "low": [
    "**/*.md",
    ".changeset/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.mjs",
    "**/*.stories.tsx",
    "docs/src/content/**"
  ],
  "notLow": [
    "REVIEW.md",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/upgrade.md",
    "docs/release-channels.md",
    "docs/deploy*"
  ],
  "notCount": [
    "release/migrations.lock.json",
    "release/kit.json",
    "pnpm-lock.yaml"
  ],
  "ignoreRenames": true,
  "harryOk": [
    "platform/services/*/src/migrat*",
    "platform/services/*/src/migrations/**",
    "platform/packages/service-kit/src/migrate.ts",
    "platform/services/updater/src/signers.ts",
    "infra/deploy/backup/**",
    "infra/deploy/postgres/**",
    "scripts/promote*",
    "scripts/halt*",
    ".github/workflows/promote.yml",
    ".github/workflows/halt.yml",
    "scripts/review-tier*",
    ".github/workflows/review.yml",
    ".github/review-tiers.json"
  ],
  "harryOkWhen": [
    {
      "paths": [
        "release/migrations.lock.json"
      ],
      "added": "\"\\d{3}_",
      "why": "adds or changes a migration"
    },
    {
      "paths": [
        ".github/workflows/**",
        ".github/actions/**"
      ],
      "added": "^\\s*permissions:|: *write\\b|\\bsecrets\\b|id-token|pull_request_target|workflow_run|issue_comment|uses:\\s*['\"]?docker://|^\\s*(container|services):|^\\s*image:",
      "why": "gives a workflow more privilege, a riskier trigger or a new image"
    },
    {
      "paths": [
        ".github/workflows/**",
        ".github/actions/**"
      ],
      "removed": "^\\s*permissions:|: *(read|none)\\b",
      "why": "takes a limit off a workflow's token"
    },
    {
      "paths": [
        ".github/workflows/**",
        ".github/actions/**"
      ],
      "newAction": true,
      "why": "uses an action no workflow used before"
    }
  ],
  "autoOk": true,
  "deployTest": [
    "infra/**",
    "release/**",
    "contracts/**",
    "platform/services/*/src/**",
    "platform/services/*/package.json",
    "platform/packages/*/src/**",
    "platform/packages/*/package.json",
    "platform/frontends/sign-in-theme/**",
    "package.json",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml"
  ],
  "notDeployTest": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.mjs",
    "**/*.testing.ts",
    "**/README.md",
    "infra/docker-compose.yml"
  ]
}
